// ============================================================
// SECTION 12 — UZA IDENTITY
// One person, one permanent public identifier, referenced by every other UZA system.
// Nothing in the Tunga Taxi programme works without it.
// ============================================================

/// Allocates the numeric part of a public reference, per scope, per year.
///
/// Mirrors how invoiceNumber and paymentReference are already minted in this codebase
/// (UZM-INV-2026-000123), so there is one pattern here and not two.
model IdSequence {
  id        String   @id @default(cuid())
  scope     String // "person", "invoice", "payment"
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([scope, year])
  @@map("id_sequences")
}

/// Lets any other UZA system resolve its own local key to a UZA ID without needing a
/// column on a table it does not own. uza-charge writes one row per driver here; the
/// garage, the academy and anything built later do the same.
///
/// This is what turns "one client served by many projects" into a query rather than a
/// reconciliation exercise.
model IdentityLink {
  id         String   @id @default(cuid())
  uzaId      String
  system     String // "uza-charge", "garage", "nexus", "unguka-portal"
  externalId String // the primary key in that system
  linkedAt   DateTime @default(now())
  linkedBy   String? // the user who made the link; null when it was automatic

  user User @relation(fields: [uzaId], references: [uzaId])

  @@unique([system, externalId])
  @@index([uzaId])
  @@map("identity_links")
}

// ============================================================
// SECTION 15 — SUPERVISED PLACEMENT
// The 90-day operating record. This is the table the whole affordability
// argument rests on: it is where "this driver can service the instalment"
// stops being a claim and becomes a measurement.
// ============================================================

enum PlacementStatus {
  ACTIVE
  COMPLETED
  EXTENDED // did not clear cover in 90 days; UZA kept going rather than submit
  ENDED // stopped early; reason mandatory
}

enum PlacementDaySource {
  APP // settled trips from the ride-hailing app — preferred
  CHARGING // inferred from charging sessions when the app was not used
  MANUAL // entered by a field officer; must carry enteredBy
}

model PlacementProgramme {
  id        String          @id @default(cuid())
  userId    String
  listingId String? // the fleet vehicle they are placed in, not the one they will own
  status    PlacementStatus @default(ACTIVE)

  startedOn  DateTime  @db.Date
  endedOn    DateTime? @db.Date
  targetDays Int       @default(90)
  endReason  String?

  /// Denormalised rollups, recomputed on each day written. Kept here so the
  /// pipeline table and the readiness engine never scan the day rows.
  daysOperated    Int    @default(0)
  grossRwfTotal   BigInt @default(0)
  netRwfTotal     BigInt @default(0)
  avgNetPerDayRwf BigInt @default(0)
  utilisationPct  Int    @default(0) // days operated / working days available

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User           @relation(fields: [userId], references: [id])
  days PlacementDay[]

  @@index([userId, status])
  @@map("placement_programmes")
}

/// One row per driver per calendar day. A day the driver did not work is a row
/// with zeroes and a reason — an absent row means "we do not know", which is a
/// different and more important thing to be able to say to a bank.
model PlacementDay {
  id          String             @id @default(cuid())
  placementId String
  day         DateTime           @db.Date
  source      PlacementDaySource @default(APP)

  operated   Boolean @default(true)
  offReason  String? // sick, vehicle in garage, no fares, personal
  tripsCount Int     @default(0)
  kmDriven   Float?
  kwhCharged Float?

  grossRwf       BigInt @default(0)
  commissionRwf  BigInt @default(0)
  energyRwf      BigInt @default(0)
  runningCostRwf BigInt @default(0)
  /// Stored, not computed on read, so the cover ratio a bank saw on a given
  /// date can be reproduced exactly even if the cost assumptions later change.
  netRwf         BigInt @default(0)

  enteredBy String? // required when source = MANUAL
  createdAt DateTime @default(now())

  placement PlacementProgramme @relation(fields: [placementId], references: [id])

  @@unique([placementId, day])
  @@index([day])
  @@index([placementId, operated])
  @@map("placement_days")
}

// ------------------------------------------------------------
// Affordability, computed from this table and nowhere else:
//
//   monthlyNet = avgNetPerDayRwf * WORKING_DAYS_PER_MONTH   (26)
//   cover      = monthlyNet / proposedInstalment
//   passes     = cover >= DSCR                              (1.25)
//
// Rules that keep it honest:
//   · Never accept a declared figure into this table.
//   · MANUAL rows must carry enteredBy and should be a small minority;
//     if most of a file is MANUAL, that is a finding, not a placement.
//   · Non-operated days stay in the average. Excluding them would flatter
//     every driver who works less, which is the opposite of what the bank
//     needs to see.
// ------------------------------------------------------------

// ============================================================
// SECTION 14 — UZA ACADEMY
// Training that produces evidence a credit committee can read.
// Built from the auto-entrepreneur-hub brief, not from a generic LMS:
// the candidates are experienced drivers with low formal literacy, so
// assessment is oral, in Kinyarwanda, and recorded.
// ============================================================

enum ModuleKind {
  VEHICLE // the EV itself: charging, range, daily checks
  SAFETY // road craft, assessed on road
  LITERACY // what a loan is, the daily number, the account, a bad day
  BUSINESS // pricing, expenses, planning — the entrepreneur half of the brief
}

enum EnrolmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  WITHDRAWN // left of their own accord
  STOPPED // UZA ended it; reason is mandatory
}

model AcademyModule {
  id       String     @id @default(cuid())
  code     String     @unique // ACD-05
  title    String
  kind     ModuleKind
  hours    Float
  sequence Int
  summary  String?
  isActive Boolean    @default(true)

  /// Modules 5 and 7 are delivered by an Unguka credit officer, not by UZA.
  /// The driver should meet the lender before the lender is a stranger.
  deliveredByPartner String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance ModuleAttendance[]

  @@index([kind, sequence])
  @@map("academy_modules")
}

/// A training group.
///
/// Extended by migration 13 rather than duplicated: a cohort is one thing whether the
/// academy or the candidate journey is looking at it, and two tables called Cohort would
/// disagree within a month.
///
/// Mixed by design. A cohort that is only one lender's referrals proves only that UZA can
/// fix that lender's rejects. A mixed cohort proves the programme works on the segment,
/// which is the claim worth making — and it lets the lender watch its own referrals against
/// a control group it did not choose.
model Cohort {
  id       String    @id @default(cuid())
  code     String    @unique // TT-2026-01
  name     String
  partner  String? // "LOLC Unguka Finance"
  startsOn DateTime  @db.Date
  endsOn   DateTime? @db.Date

  // --- added by migration 13 ---
  track        String  @default("TUNGA_TAXI") // TUNGA_TAXI | WOMENS_FLEET | UZA_TEKINIKI | DRIVERS_POOL
  /// Ten weeks is the design. Held per cohort because the first one will teach us it is
  /// wrong in some direction, and the plan should record what was actually attempted.
  plannedWeeks Int     @default(10)
  location     String?
  /// Kinyarwanda is the language of instruction; English is the translation.
  language     String  @default("rw")

  seatsPlanned      Int?
  seatsForReferrals Int?
  seatsForRecruits  Int?
  /// A women-MAJORITY cohort where that is the design — not a quota inside a male cohort.
  womenTargetPct    Int?

  status String @default("planned") // planned | running | complete | cancelled

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrolments Enrolment[]
  journeys   CandidateJourney[]

  fundApplications FundApplication[]

  @@index([track, status])
  @@map("cohorts")
}

model Enrolment {
  id       String          @id @default(cuid())
  userId   String
  cohortId String
  status   EnrolmentStatus @default(ENROLLED)

  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  stoppedAt   DateTime?
  stopReason  String? // required when status = STOPPED

  user   User   @relation(fields: [userId], references: [id])
  cohort Cohort @relation(fields: [cohortId], references: [id])

  attendance  ModuleAttendance[]
  assessments Assessment[]

  @@unique([userId, cohortId])
  @@index([cohortId, status])
  @@map("enrolments")
}

model ModuleAttendance {
  id          String   @id @default(cuid())
  enrolmentId String
  moduleId    String
  attendedAt  DateTime
  assessorId  String? // userId of the trainer
  passed      Boolean  @default(false)
  notes       String?

  enrolment Enrolment     @relation(fields: [enrolmentId], references: [id])
  module    AcademyModule @relation(fields: [moduleId], references: [id])

  @@unique([enrolmentId, moduleId])
  @@map("module_attendance")
}

enum AssessmentKind {
  COMPREHENSION // the six questions about the loan
  ROAD_CRAFT // assessed on road
  EV_CARE // daily checks, charging, when to book a job card
}

/// Immutable. A re-test writes a new row pointing at the one it supersedes,
/// so a falling comprehension score is visible rather than overwritten —
/// and a falling score is itself an early-warning signal.
model Assessment {
  id          String         @id @default(cuid())
  enrolmentId String
  kind        AssessmentKind

  scorePct     Int // 0-100
  language     String  @default("rw") // rw, en, fr — matches User.preferredLanguage
  oral         Boolean @default(true)
  recordingUrl String? // attaches to the bank file; retention policy applies

  assessedAt DateTime
  assessorId String?
  retestOfId String? // the assessment this supersedes
  dueAgainOn DateTime? @db.Date // day 30 and day 90 re-tests

  createdAt DateTime @default(now())

  enrolment Enrolment          @relation(fields: [enrolmentId], references: [id])
  answers   AssessmentAnswer[]

  @@index([enrolmentId, kind, assessedAt])
  @@map("assessments")
}

/// One row per question. Storing answers individually is what lets UZA say
/// "four of six, and here is which two were missed" instead of just "67%" —
/// and it tells the trainer exactly what to re-teach.
model AssessmentAnswer {
  id           String  @id @default(cuid())
  assessmentId String
  questionCode String // LIT-Q1 .. LIT-Q6
  correct      Boolean
  note         String?

  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@unique([assessmentId, questionCode])
  @@map("assessment_answers")
}

// ============================================================
// SECTION 13 — WALLET, LEDGER AND THE DAILY SPLIT
// The repayment mechanism. Money here is whole RWF in BigInt, never Float.
// See README, deviation 1.
// ============================================================

enum WalletStatus {
  ACTIVE
  SUSPENDED // frozen by UZA or the driver; sweeps stop, deposits still land
  CLOSED
}

enum LedgerDirection {
  CREDIT // money into the wallet
  DEBIT // money out
}

/// What the money is FOR. The label a driver puts on their own money, and the thing that
/// makes "I saved RWF 40,000 for maintenance" a sentence the wallet can say back to them.
///
/// Evidence: labelled and commitment accounts raise savings (Ashraf, Karlan & Yin 2006,
/// SEED, +81%; Dupas & Robinson 2013). Legal shape: these are LEDGER VIEWS over the
/// client's own funds at the licensed institution — UZA never holds or moves money. A
/// bucket is a purpose tag on the client's balance; the instalment reaches the loan account
/// under the client's own standing instruction (SweepMandate), executed by the bank.
enum LedgerBucket {
  LOAN // the instalment — first call on every day's money
  MAINTENANCE // the next tyre, the service, the inspection
  CHARGING // energy — what fuel money used to be
  INSURANCE // the quarterly premium-financing instalment (02 §3.7)
  PERSONAL // the driver's own — never swept, never touched by UZA
}

/// Who put a ledger line there, and therefore how much it is worth as evidence.
enum LedgerRecordedBy {
  DRIVER // the driver recorded it themselves, with the MoMo transaction reference
  STAFF // a UZA staff member keyed it from a statement or receipt
  INSTITUTION // matched against the licensed institution's own statement — confirmed
}

enum LedgerReason {
  TRIP_FARE // settled from the ride-hailing app
  CASH_DEPOSIT // paid in at a charging station or agent
  MOMO_DEPOSIT // MTN MoMo / Airtel Money top-up
  COMMISSION // UZA Move commission
  ENERGY // charging paid from the wallet
  INSTALMENT_SWEEP // out to the driver's own bank account
  RESERVE_FUND // into the reserve
  RESERVE_DRAW // out of the reserve to cover a short day
  RESERVE_RETURN // reserve paid back to the driver when the loan closes
  WITHDRAWAL // driver takes their own money
  ADJUSTMENT // corrections — always paired with a note, never silent
}

/// NOTE — a wallet already exists in uza-charge: public.drivers carries
/// wallet_balance_rwf, and public.payments already accepts method = 'wallet'.
/// It is a mutable balance with no ledger behind it. Do not build a second one
/// beside it — see 06-uza-charge-join.sql section 3b for the two options and
/// the decision that has to be made before any ledger code is written.
model Wallet {
  id     String       @id @default(cuid())
  userId String       @unique
  status WalletStatus @default(ACTIVE)

  balanceRwf        BigInt @default(0) // spendable by the driver
  reserveBalanceRwf BigInt @default(0) // the driver's money, ring-fenced
  reserveTargetDays Int    @default(15) // instalment-days the reserve aims to hold
  reserveRatePct    Int    @default(8) // % of daily net funding the reserve

  /// The number the driver lives by: instalment ÷ 26 working days. Set from the loan quote
  /// (or the target vehicle before a loan exists) and shown on every screen.
  dailyTargetRwf           Int?
  /// The contribution the band requires for the target vehicle. The progress bar's 100%.
  contributionTargetRwf    Int?
  /// Whose money it actually is, and where. Displayed on every wallet screen so no driver
  /// ever believes UZA holds their savings. The account number never enters this system.
  institutionName          String?
  institutionAccountMasked String?
  /// Default split of a day's money across buckets, in percent, LOAN first. Sums to 100.
  /// Rules of thumb, not accounting: pay the car first; two purses; the bad-week rule.
  splitLoanPct             Int     @default(60)
  splitMaintenancePct      Int     @default(10)
  splitChargingPct         Int     @default(15)
  splitInsurancePct        Int     @default(5)
  splitPersonalPct         Int     @default(10)

  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  updatedAt DateTime  @updatedAt

  user    User          @relation(fields: [userId], references: [id])
  entries LedgerEntry[]
  splits  DailySplit[]

  @@map("wallets")
}

/// Append-only. Never updated, never deleted — a correction is a new
/// ADJUSTMENT entry, so the history stays readable.
model LedgerEntry {
  id        String          @id @default(cuid())
  walletId  String
  direction LedgerDirection
  reason    LedgerReason
  amountRwf BigInt

  /// Running balance after this entry, so a statement is a SELECT and never a
  /// recomputation. If this ever disagrees with SUM(entries), the ledger is
  /// broken and should refuse to write.
  balanceAfterRwf        BigInt
  reserveBalanceAfterRwf BigInt

  /// The single most important column here. A MoMo callback that fires twice,
  /// a retried job, a replayed webhook — all must land once. Build the key from
  /// the source event, never from a timestamp.
  ///   momo:{transactionId} · trip:{tripId} · session:{chargingSessionId}
  ///   sweep:{walletId}:{yyyy-mm-dd}
  idempotencyKey String @unique

  externalRef  String? // MoMo txn id, trip id, charging session id
  note         String?
  /// Which purpose this line belongs to. Null only for legacy or bucket-neutral lines
  /// (COMMISSION, ADJUSTMENT at wallet level).
  bucket       LedgerBucket?
  /// A line recorded by the driver is a CLAIM until it is matched to the institution's
  /// statement. The UI shows both states honestly; a lender's view counts only confirmed.
  recordedBy   LedgerRecordedBy @default(DRIVER)
  confirmedAt  DateTime?
  confirmedRef String? // the institution's statement line / bank reference
  occurredAt   DateTime // when it happened in the real world
  createdAt    DateTime         @default(now()) // when we recorded it

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId, occurredAt])
  @@index([reason, occurredAt])
  @@index([walletId, bucket])
  @@map("ledger_entries")
}

enum MandateStatus {
  PENDING // signed at the branch, not yet active
  ACTIVE
  REVOKED // driver withdrew it — an early-warning trigger, not an error
}

/// UZA's only instrument over the driver's bank account. It authorises a
/// transfer out of the wallet into an account in the driver's own name.
/// It is not a debit authority over that account, and it is revocable.
model SweepMandate {
  id     String        @id @default(cuid())
  userId String        @unique
  status MandateStatus @default(PENDING)

  bankName            String
  accountHolderName   String // must match the driver, checked at the branch
  accountNumberMasked String // last 4 only; the full number never enters this system
  standingOrderRef    String? // the bank's own reference for savings -> loan

  signedAt    DateTime
  activatedAt DateTime?
  revokedAt   DateTime?
  revokedBy   String? // "driver" or a userId — revocation must be attributable

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([status])
  @@map("sweep_mandates")
}

/// One row per driver per working day. This is what the bank is shown when it
/// asks "how was the instalment met on the 14th?" — and it is the table that
/// makes a reserve draw visible before a payment is ever missed.
model DailySplit {
  id        String   @id @default(cuid())
  walletId  String
  splitDate DateTime @db.Date

  grossRwf       BigInt @default(0)
  commissionRwf  BigInt @default(0)
  energyRwf      BigInt @default(0)
  runningCostRwf BigInt @default(0) // maintenance, licence, insurance accrual
  netRwf         BigInt @default(0)

  instalmentRwf   BigInt @default(0) // first call on the day
  reserveRwf      BigInt @default(0) // second
  reserveDrawnRwf BigInt @default(0) // > 0 means the day was short
  driverRwf       BigInt @default(0) // what was left

  sweptAt   DateTime? // null until the transfer to the bank confirms
  sweepRef  String?
  createdAt DateTime  @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@unique([walletId, splitDate])
  @@index([splitDate])
  @@index([walletId, sweptAt])
  @@map("daily_splits")
}

// ------------------------------------------------------------
// The split rule, in order. Encode it once, here, and let every
// caller read it — do not scatter these percentages through services.
//
//   net        = gross - commission - energy - runningCost
//   instalment = min(net, dailyInstalmentDue)
//   shortfall  = dailyInstalmentDue - instalment
//   if shortfall > 0 -> RESERVE_DRAW of min(shortfall, reserveBalance)
//   reserve    = reserveBalance < target ? net * reserveRatePct / 100 : 0
//   driver     = net - instalment - reserve
//
// Two invariants worth asserting in code, not just hoping for:
//   1. grossRwf - commissionRwf - energyRwf - runningCostRwf == netRwf
//   2. instalmentRwf + reserveRwf + driverRwf <= netRwf
// ------------------------------------------------------------

// ============================================================
// SECTION 16 — READINESS
// Six pillars, 100 points, 70 to submit. Apply this LAST: a score computed
// from tables that do not exist yet is a score computed from nothing.
//
// Not a credit score, and the API should never call it one. It is a
// structured evidence summary with a threshold UZA imposes on itself.
// ============================================================

enum ReadinessPillar {
  OPERATING_CAPABILITY // 25 — from placement_days
  PAYMENT_DISCIPLINE // 25 — from Save2Own deposits and rent history
  COMPREHENSION // 15 — from assessments
  ASSET_STEWARDSHIP // 15 — from inspections, charging and harsh events
  IDENTITY_COMPLIANCE // 10 — documents, TIN-linked phone, account in own name
  SUPPORT_STRUCTURE // 10 — own contribution, collateral cover, reserve
}

enum ReadinessBand {
  NOT_YET_FUNDABLE // < 50
  DEVELOPING // 50-69
  BANKABLE // 70-84
  STRONG // 85+
}

/// Immutable snapshot. Every recomputation writes a new row; exactly one row
/// per user carries isCurrent = true. A bank must be able to see the score as
/// it stood on the day the file was submitted, together with the inputs that
/// produced it — a mutable column on User cannot answer that six months later.
model ReadinessScore {
  id     String @id @default(cuid())
  userId String

  total Int
  band  ReadinessBand

  /// Bump when the weighting or any pillar formula changes. Two scores are only
  /// comparable within the same modelVersion, and the bank should be told so.
  modelVersion String @default("v1")

  computedAt DateTime @default(now())
  computedBy String? // null when computed by the nightly job
  isCurrent  Boolean  @default(true)

  /// Set when this snapshot is the one attached to a submission, so it can
  /// never be garbage-collected and always reproduces the committee's view.
  submittedWithFinancingRequestId String?

  user    User                   @relation(fields: [userId], references: [id])
  pillars ReadinessPillarScore[]

  @@index([userId, isCurrent])
  @@index([userId, computedAt])
  @@map("readiness_scores")
}

model ReadinessPillarScore {
  id      String          @id @default(cuid())
  scoreId String
  pillar  ReadinessPillar

  points    Int
  maxPoints Int

  /// The figures the points were derived from — days operated, cover ratio,
  /// deposit streak, assessment score. Stored so a decision is reproducible
  /// without re-querying tables that have since moved on.
  inputs Json

  score ReadinessScore @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  @@unique([scoreId, pillar])
  @@map("readiness_pillar_scores")
}

/// The evidence pack, one row per required item. Separate from the score
/// because completeness and quality are different questions: a file can be
/// complete and still score 54.
model EvidenceItem {
  id     String @id @default(cuid())
  userId String

  code  String // EV-ID, EV-LICENCE, EV-PLACEMENT, EV-COMPREHENSION, ...
  label String

  satisfiedAt  DateTime?
  sourceSystem String? // "academy", "placement", "uza-charge", "documents"
  sourceRef    String? // the row that satisfied it — so it is checkable
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, code])
  @@index([userId, satisfiedAt])
  @@map("evidence_items")
}

// ------------------------------------------------------------
// Rules the service must enforce, not merely document:
//
//  1. UZA does not submit a file below 70. The threshold belongs to UZA,
//     not to Unguka — the bank's own policy is applied afterwards and
//     independently.
//  2. A pillar with no underlying data scores 0, never a default or an
//     average. An absent placement record is not a neutral fact.
//  3. Recompute nightly and on any source-table write. A score is a claim
//     about today; a stale one is worse than none.
//  4. Scores can fall. Do not clamp to the previous maximum — a driver whose
//     utilisation drops should see it, and so should the bank.
//  5. When a score is attached to a submission, stamp
//     submittedWithFinancingRequestId and never delete that row.
// ------------------------------------------------------------

// ============================================================
// SECTION 17 — CANDIDATE LIFECYCLE, DRIVER POOL, MANAGED FLEET
//
// The lifecycle the founder described: a person starts as a candidate, earns a
// certificate, and then branches — some are ready for a loan, some need more
// experience, some are waiting for a vehicle to land from China. The last two
// groups are not idle. They are a pool of trained, equipped, insurable drivers,
// and that pool is a business.
//
// Apply AFTER 01 (identity) and 03 (academy). The certificate is the gate
// between them and everything here.
// ============================================================

enum DriverStage {
  CANDIDATE // registered, academy not started
  IN_ACADEMY
  CERTIFIED // passed — this is the gate
  POOL_AVAILABLE // certified and earning while they wait
  FINANCING_SUBMITTED
  FINANCING_APPROVED
  IN_TRANSFER
  OWNER_DRIVER // driving a vehicle they are buying
  EXITED
}

enum PoolReason {
  AWAITING_VEHICLE // unit ordered from China, not landed
  BUILDING_EXPERIENCE // certified, readiness still below the submission threshold
  AWAITING_BANK // file with the bank, decision pending
  BY_CHOICE // wants to drive, does not want to own — a valid end state
}

model DriverProfile {
  id     String      @id @default(cuid())
  userId String      @unique
  stage  DriverStage @default(CANDIDATE)

  poolReason    PoolReason?
  availableFrom DateTime?   @db.Date
  homeDistrict  String?
  licenceClass  String?
  yearsDriving  Int?

  /// Rolling average from completed assignments, 0-100. Owner-facing, so it
  /// must be computed from recorded facts (completion, incidents, punctuality)
  /// and never typed in by an account manager.
  serviceScore Int?

  stageChangedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([stage, poolReason])
  @@index([stage, availableFrom])
  @@map("driver_profiles")
}

/// The certificate is a real object, not a boolean. It has a public code so a
/// driver can show it to anyone — including an employer who is not UZA. That
/// portability is the honest part of the promise made to candidates who do not
/// go on to get a loan.
model Certificate {
  id     String @id @default(cuid())
  userId String
  code   String @unique // UZA-CERT-2026-000123

  issuedAt  DateTime
  expiresAt DateTime? // competence ages; a lapsed certificate should re-test

  modulesPassed    Int
  comprehensionPct Int
  roadCraftPassed  Boolean @default(false)
  evCarePassed     Boolean @default(false)

  revokedAt    DateTime?
  revokeReason String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, issuedAt])
  @@map("certificates")
}

// ------------------------------------------------------------
// MANAGED VEHICLES
// A vehicle UZA operates that it does not own. The owner may be an investor,
// a company, or an individual client.
// ------------------------------------------------------------

enum VehicleOwnership {
  UZA_FLEET // UZA's own vehicle — used for placement
  CLIENT_MANAGED // owned by a client, operated by UZA
  DRIVER_OWNED // financed by a driver; UZA services it but does not operate it
}

enum ManagedVehicleStatus {
  ONBOARDING
  ACTIVE
  IN_GARAGE
  IDLE // available but unassigned — the number the owner cares about most
  OFFBOARDED
}

model ManagedVehicle {
  id          String               @id @default(cuid())
  ownerUserId String
  listingId   String? // if UZA sourced it, the listing it came from
  plate       String               @unique
  vin         String?
  ownership   VehicleOwnership
  status      ManagedVehicleStatus @default(ONBOARDING)

  onboardedAt  DateTime?
  offboardedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agreement   ManagementAgreement?
  assignments DriverAssignment[]
  days        VehicleDay[]

  @@index([ownerUserId, status])
  @@index([status])
  @@map("managed_vehicles")
}

enum FeeBasis {
  PERCENT_OF_GROSS
  FIXED_DAILY
  FIXED_MONTHLY
}

model ManagementAgreement {
  id               String @id @default(cuid())
  managedVehicleId String @unique
  ownerUserId      String

  feeBasis    FeeBasis
  feePercent  Int? // when PERCENT_OF_GROSS
  feeFixedRwf BigInt? // when FIXED_DAILY or FIXED_MONTHLY

  driverSupplied Boolean @default(true)
  insuranceBy    String // "owner" | "uza" — must be explicit, never assumed
  maintenanceBy  String // "owner" | "uza"

  /// ⚠ LEGAL TRIPWIRE — read before setting this.
  /// A management contract where UZA guarantees the owner a minimum income is
  /// no longer a service contract. It is an investment promise, and combined
  /// with UZA sourcing the vehicle and operating it, it looks like a security
  /// in most jurisdictions — a different regulator from the BNR path already
  /// under way. Leave this NULL unless a lawyer has signed off in writing, and
  /// record that sign-off in guaranteeApprovalRef.
  minGuaranteeRwf      BigInt?
  guaranteeApprovalRef String?

  startsOn     DateTime  @db.Date
  endsOn       DateTime? @db.Date
  signedDocRef String
  terminatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  managedVehicle ManagedVehicle @relation(fields: [managedVehicleId], references: [id])

  @@map("management_agreements")
}

// ------------------------------------------------------------
// ASSIGNMENTS — a driver to a vehicle, for a period
// One model covers all three cases, because they are the same fact:
//   PLACEMENT      — pool driver in a UZA fleet vehicle, proving income
//   MANAGED_FLEET  — pool driver in a client's vehicle, earning a fee
//   OWNER          — the driver in the vehicle they are buying
// ------------------------------------------------------------

enum AssignmentKind {
  PLACEMENT
  MANAGED_FLEET
  OWNER
}

enum AssignmentStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

enum AssignmentBasis {
  DAILY
  MONTHLY
}

enum DriverPayBasis {
  SHARE_OF_NET // driver keeps a percentage
  FIXED_DAILY
  FIXED_MONTHLY
}

model DriverAssignment {
  id               String           @id @default(cuid())
  userId           String
  managedVehicleId String
  kind             AssignmentKind
  status           AssignmentStatus @default(SCHEDULED)
  basis            AssignmentBasis  @default(MONTHLY)

  startsOn DateTime  @db.Date
  endsOn   DateTime? @db.Date

  driverPayBasis DriverPayBasis
  driverPayRwf   BigInt? // when FIXED_*
  driverSharePct Int? // when SHARE_OF_NET

  /// ⚠ EMPLOYMENT STATUS — decide per assignment kind, not per driver.
  /// A PLACEMENT driver is a trainee on a revenue share. A MANAGED_FLEET driver
  /// is supplied by UZA to a paying client, scheduled by UZA and paid by UZA —
  /// which in most readings makes them an employee, with RSSB and PAYE. Record
  /// which it is here so payroll can be reconciled against it later, and do not
  /// let the two blur.
  engagement String // "trainee" | "employee" | "contractor"

  requestedById String? // the owner who asked for a driver
  endedReason   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id])
  managedVehicle ManagedVehicle @relation(fields: [managedVehicleId], references: [id])

  @@index([managedVehicleId, status])
  @@index([userId, status])
  @@index([status, startsOn])
  @@map("driver_assignments")
}

enum DriverRequestStatus {
  OPEN
  MATCHED
  FULFILLED
  CANCELLED
  UNFULFILLED // no driver available — count these, they size the pool
}

/// "Request a driver, daily or monthly." Kept as its own record rather than
/// created straight as an assignment, because the requests UZA CANNOT fill are
/// the most valuable number in the whole fleet business: they tell you exactly
/// how many more people to put through the academy.
model DriverRequest {
  id               String              @id @default(cuid())
  requestedById    String
  managedVehicleId String?
  basis            AssignmentBasis
  neededFrom       DateTime            @db.Date
  neededTo         DateTime?           @db.Date
  district         String?
  status           DriverRequestStatus @default(OPEN)

  matchedAssignmentId String?
  unfulfilledReason   String?
  notes               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, neededFrom])
  @@map("driver_requests")
}

/// One row per managed vehicle per day. This is what the owner dashboard reads,
/// and it deliberately mirrors PlacementDay so a vehicle can move between
/// placement and managed-fleet use without a second reporting path.
model VehicleDay {
  id               String   @id @default(cuid())
  managedVehicleId String
  day              DateTime @db.Date

  assignmentId String?
  driverUserId String?

  grossRwf         BigInt @default(0)
  energyRwf        BigInt @default(0)
  commissionRwf    BigInt @default(0)
  driverPayRwf     BigInt @default(0)
  maintenanceRwf   BigInt @default(0)
  managementFeeRwf BigInt @default(0)
  /// What the owner actually receives. Stored, so a statement issued in March
  /// still reconciles in December even if the fee basis changes in between.
  ownerNetRwf      BigInt @default(0)

  operated   Boolean @default(true)
  idleReason String? // no driver, in garage, owner withdrew it
  kmDriven   Float?
  tripsCount Int     @default(0)

  createdAt DateTime @default(now())

  managedVehicle ManagedVehicle @relation(fields: [managedVehicleId], references: [id])

  @@unique([managedVehicleId, day])
  @@index([day])
  @@index([managedVehicleId, operated])
  @@map("vehicle_days")
}

// ------------------------------------------------------------
// Why the pool matters more than it looks
//
// Memory of this business says the binding constraint is stock, not demand. A
// graduate who waits four months for a container is a graduate who stops
// saving, forgets module 6, and drifts. Put the same person in the pool and
// the wait becomes the opposite of decay:
//
//   · Save2Own keeps running          -> PAYMENT_DISCIPLINE keeps accruing
//   · Trips keep being logged         -> OPERATING_CAPABILITY keeps accruing
//   · Charging telemetry keeps flowing -> ASSET_STEWARDSHIP keeps accruing
//
// The waiting time stops being a cost and starts producing the evidence the
// bank underwrites on. That is the argument for the pool — the fleet revenue
// is the second reason, not the first.
// ------------------------------------------------------------

// ============================================================
// SECTION 18 — MEMBERSHIP AND BENEFITS
//
// The UZA ID unlocking better terms at UZA and partner charging, spare parts
// and services.
//
// Two design decisions that are not obvious and matter a lot:
//
//  1. This is NOT a discount card. A flat discount is a cost that grows with
//     volume and buys nothing. A tier that MOVES with behaviour is a credit
//     control: a driver repaying on time gets a better rate, a driver in
//     arrears loses it, and the incentive points the same way the bank's does.
//     Tie the tier to readiness and repayment, which already exist.
//
//  2. Every benefit must say WHO FUNDS IT and every redemption must record how
//     it was split. A partner discount with no settlement record is an
//     unfunded promise, and unfunded promises die quietly at renewal — usually
//     right after the drivers have come to rely on them.
//
// Apply after 01 (identity) and 05 (readiness).
// ============================================================

enum MembershipTier {
  NEW // registered, nothing proven yet
  ACTIVE // in the academy or the pool, behaving
  TRUSTED // repaying on time, telemetry clean — the tier worth earning
  SUSPENDED // in arrears, mandate revoked, or certificate lapsed
}

model Membership {
  id     String         @id @default(cuid())
  userId String         @unique
  tier   MembershipTier @default(NEW)

  tierSince  DateTime @default(now())
  reviewedAt DateTime @default(now())

  /// Why they are on this tier, in words a field officer can read aloud to the
  /// driver. A tier a person cannot have explained to them is a tier they will
  /// not trust, and this one can go down as well as up.
  reasonCode String // ON_TIME_90_DAYS, ARREARS, MANDATE_REVOKED, CERT_LAPSED
  reasonNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User                @relation(fields: [userId], references: [id])
  redemptions BenefitRedemption[]

  @@index([tier])
  @@map("memberships")
}

enum BenefitKind {
  CHARGING_DISCOUNT
  PARTS_DISCOUNT
  SERVICE_DISCOUNT // garage labour
  INSURANCE_RATE
  FEE_WAIVER
  PRIORITY_ACCESS // pool assignments, service slots, new stock
}

enum BenefitFundedBy {
  UZA // UZA absorbs it — a marketing or credit-control cost
  PARTNER // the partner absorbs it, in exchange for footfall
  SHARED // split; uzaSharePct says how
}

model PartnerBenefit {
  id            String  @id @default(cuid())
  code          String  @unique // BEN-CHG-TRUSTED
  partnerName   String
  partnerUserId String? // set when the partner is a UZA account holder

  kind    BenefitKind
  minTier MembershipTier @default(ACTIVE)

  discountPct      Int?
  discountFixedRwf BigInt?
  /// Caps stop a good idea becoming an open-ended liability. Both optional,
  /// both strongly recommended before any benefit goes live.
  maxPerDayRwf     BigInt?
  maxPerMonthRwf   BigInt?

  fundedBy    BenefitFundedBy
  uzaSharePct Int? // required when fundedBy = SHARED

  /// The signed agreement. A benefit without one is a verbal arrangement that
  /// nobody will honour when the person who agreed it leaves.
  termsRef String?

  startsOn DateTime  @db.Date
  endsOn   DateTime? @db.Date
  isActive Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions BenefitRedemption[]

  @@index([isActive, kind])
  @@index([partnerName])
  @@map("partner_benefits")
}

/// Append-only, idempotent, and it records the funding split at the moment of
/// redemption — so UZA can invoice a partner, or be invoiced, from this table
/// alone and never from a spreadsheet.
model BenefitRedemption {
  id        String @id @default(cuid())
  benefitId String
  userId    String
  uzaId     String // denormalised on purpose: partners quote the UZA ID, not a cuid

  occurredAt DateTime
  location   String? // station id, garage, shop

  grossRwf    BigInt
  discountRwf BigInt

  fundedByUzaRwf     BigInt @default(0)
  fundedByPartnerRwf BigInt @default(0)

  externalRef    String? // charging session id, invoice number, receipt
  /// Same discipline as the ledger: a redemption that fires twice must land
  /// once. Build it from the source event.
  idempotencyKey String  @unique

  settledAt DateTime? // when the partner was invoiced or credited
  createdAt DateTime  @default(now())

  benefit    PartnerBenefit @relation(fields: [benefitId], references: [id])
  membership Membership     @relation(fields: [userId], references: [userId])

  @@index([userId, occurredAt])
  @@index([benefitId, occurredAt])
  @@index([settledAt])
  @@map("benefit_redemptions")
}

// ------------------------------------------------------------
// Two limits to hold, whatever the commercial pressure
//
// 1. The ID MUST NOT STORE VALUE. The moment it holds a balance that can be
//    spent, it is e-money and needs a BNR licence UZA does not have. It stays
//    an identifier that unlocks a rate; payment continues to run through MoMo
//    and the wallet. This is a cheap line to hold now and an expensive one to
//    walk back later.
//
// 2. Collect only what the driver also benefits from. This table records where
//    a person charges, what they buy and when they work. That is defensible
//    because each entry earns them money — and stops being defensible the
//    moment it is used for anything else, or sold. Say so in the terms the
//    driver signs, in Kinyarwanda.
//
// Invariant worth asserting in code:
//    fundedByUzaRwf + fundedByPartnerRwf == discountRwf
// ------------------------------------------------------------

// ============================================================
// SECTION 19 — SUPPLY TRACKING AND COUNTERPARTY PARTITIONS
//
// Follow a vehicle by supplier and by settlement route, from requirement
// to listing — and keep counterparties from seeing each other.
//
// The governing idea: THE VEHICLE IS THE JOIN, AND IT IS THE ONLY THING
// THAT CROSSES THE PARTITION.
//   · The supplier sees the vehicle as an order line he is owed money on.
//   · The lender sees the same vehicle as security against a driver's loan.
//   · Neither sees the other's relationship to it.
// That is a permissions design, not two databases.
//
// Apply after 01 (identity) and 07 (pool and fleet).
// ============================================================

enum SupplierKind {
  MANUFACTURER // direct from the factory
  EXPORTER // sources and exports, e.g. Mento
  TRADER
  AUCTION
}

enum SupplierStatus {
  PROSPECT
  ACTIVE
  SUSPENDED // stop new orders, finish open ones
  CLOSED
}

model Supplier {
  id        String         @id @default(cuid())
  code      String         @unique // SUP-MENTO
  legalName String // the exact registered name — payments must match it
  kind      SupplierKind
  status    SupplierStatus @default(PROSPECT)

  country         String // where the CONTRACTING entity is registered
  registrationNo  String?
  addressLine     String?
  contactName     String?
  contactPhone    String?
  contactEmail    String?
  defaultCurrency String  @default("RWF")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agreements   SupplyAgreement[]
  orders       SupplyOrder[]
  bankAccounts SupplierBankAccount[]

  @@index([status, kind])
  @@map("suppliers")
}

/// Every supplier bank account, with the verification and the dual approval
/// recorded. Changing supplier bank details is the commonest fraud committed
/// against importers, and it is defeated entirely by this table being taken
/// seriously.
model SupplierBankAccount {
  id         String @id @default(cuid())
  supplierId String

  /// MUST equal Supplier.legalName. Enforce it in the service, not by hope —
  /// a company invoice paid into a personal account has no audit trail and
  /// no counterparty.
  accountName         String
  bankName            String
  branch              String?
  accountNumberMasked String // last 4 only in this table
  swift               String?
  currency            String

  verifiedAt     DateTime?
  verifiedBy     String? // userId
  verifiedMethod String? // "voice call to previously known number"

  /// Two different people, or it did not happen.
  approvedById       String?
  secondApprovedById String?
  approvedAt         DateTime?

  isActive     Boolean @default(false)
  replacedById String? // the account this one supersedes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier Supplier        @relation(fields: [supplierId], references: [id])
  payments SupplyPayment[]

  @@index([supplierId, isActive])
  @@map("supplier_bank_accounts")
}

model SupplyAgreement {
  id         String @id @default(cuid())
  supplierId String
  ref        String @unique // AGR-MENTO-2026

  signedOn  DateTime? @db.Date
  expiresOn DateTime? @db.Date

  /// Defaults an Order inherits unless its own Addendum overrides them.
  priceBasisDefault String? // "landed Kigali, duty paid, registered"
  depositPct        Int? // 40
  arrivalPct        Int? // 10-20 — record what was AGREED, not a range
  isExclusive       Boolean @default(false)

  docRef       String? // the signed file
  terminatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier Supplier      @relation(fields: [supplierId], references: [id])
  orders   SupplyOrder[]

  @@map("supply_agreements")
}

/// How the balance settles. This is the "route" dimension — every question
/// about working capital is a question about this field.
enum SettlementRoute {
  PREPAID // paid in full before shipment — worst for cash
  ROUTE_B_ON_LANDING // balance in full on Landing
  ROUTE_A_DEFERRED // balance days after Change of Ownership, against security
}

enum SupplyOrderStatus {
  DRAFT
  EVIDENCE_REVIEW // photos, video, diagnostics, VIN plate received
  ACCEPTED // UZA accepted the condition, per VIN
  ADDENDUM_SIGNED // now binding
  DEPOSIT_PAID
  IN_PRODUCTION
  SHIPPED
  AT_PORT
  LANDED
  CLEARED
  SETTLED // balance paid, security released
  CANCELLED
}

/// One Addendum. One container, normally. This is the unit everything else
/// hangs off — never track supply at the invoice level, because an invoice
/// can be reissued and an Addendum cannot.
model SupplyOrder {
  id          String  @id @default(cuid())
  ref         String  @unique // ADD-2026-001
  supplierId  String
  agreementId String?

  route      SettlementRoute
  priceBasis String // spelled out, matching the Addendum
  currency   String

  /// "Arrival" means whatever the Addendum says it means, so record it.
  /// Port arrival and Kigali arrival are weeks and a lot of money apart.
  arrivalDefinition String // "discharge at Dar es Salaam" | "arrival in Kigali"

  depositPct      Int
  arrivalPct      Int
  orderValueMinor BigInt

  status SupplyOrderStatus @default(DRAFT)

  signedOn      DateTime? @db.Date
  depositPaidOn DateTime? @db.Date
  shippedOn     DateTime? @db.Date
  vesselName    String?
  voyageNo      String?
  blNumber      String?
  etaOn         DateTime? @db.Date
  arrivedOn     DateTime? @db.Date
  landedOn      DateTime? @db.Date
  settledOn     DateTime? @db.Date

  cancelledOn           DateTime?
  cancelReason          String?
  /// The deposit's route home if an Order dies. If this is null on a
  /// cancelled Order, someone has lost money and not written down how.
  depositRecoveredMinor BigInt?

  ownerUserId String? // Scorah owns the vehicle from order to listing

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier  Supplier             @relation(fields: [supplierId], references: [id])
  agreement SupplyAgreement?     @relation(fields: [agreementId], references: [id])
  vehicles  SupplyOrderVehicle[]
  payments  SupplyPayment[]

  @@index([supplierId, status])
  @@index([status, etaOn])
  @@index([route])
  @@map("supply_orders")
}

model SupplyOrderVehicle {
  id            String @id @default(cuid())
  supplyOrderId String

  /// 17 characters, and never containing I, O or Q. Validate on write — a
  /// mistyped VIN stalls a registration and voids a comfort letter.
  vin           String  @unique
  brand         String
  model         String
  year          Int
  colour        String?
  mileageKm     Int?
  batterySohPct Int? // measured, not claimed. Reject below the Addendum threshold.
  priceMinor    BigInt

  /// Pre-shipment acceptance — the step the supply contract does not have and
  /// the process does. Nothing ships on an unaccepted VIN.
  evidencePackRef        String?
  evidenceAcceptedAt     DateTime?
  evidenceAcceptedBy     String?
  evidenceRejectedReason String?

  balanceDueMinor BigInt?
  balancePaidOn   DateTime? @db.Date

  /// Set the day the supplier's security over this vehicle is released.
  /// A vehicle with a balance paid and this still null is an open claim
  /// against an asset someone else may already have financed.
  securityReleasedOn DateTime? @db.Date

  /// The only fields that cross the partition.
  listingId        String? // marketplace listing once published
  managedVehicleId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplyOrder SupplyOrder @relation(fields: [supplyOrderId], references: [id])

  @@index([supplyOrderId])
  @@index([listingId])
  @@index([balancePaidOn, securityReleasedOn])
  @@map("supply_order_vehicles")
}

enum SupplyPaymentStage {
  DEPOSIT
  ARRIVAL
  BALANCE
  ADJUSTMENT
}

model SupplyPayment {
  id            String             @id @default(cuid())
  supplyOrderId String
  stage         SupplyPaymentStage
  amountMinor   BigInt
  currency      String

  bankAccountId String // which verified account it actually went to
  paidOn        DateTime @db.Date
  proofRef      String? // uploaded proof, not an email

  /// Same discipline as the driver ledger: a payment instruction that fires
  /// twice must land once.
  idempotencyKey String @unique

  createdAt DateTime @default(now())

  supplyOrder SupplyOrder         @relation(fields: [supplyOrderId], references: [id])
  bankAccount SupplierBankAccount @relation(fields: [bankAccountId], references: [id])

  @@index([supplyOrderId, stage])
  @@map("supply_payments")
}

// ------------------------------------------------------------
// PARTITIONS
// ------------------------------------------------------------

enum PartyScope {
  INTERNAL // UZA staff, scoped further by role
  SUPPLIER // sees only their own SupplyOrders
  LENDER // sees only financing and the vehicles assigned to their borrowers
  CUSTOMER // sees only their own vehicle, loan and wallet
  OPERATOR // charging station owner
}

/// Binds a user account to exactly one counterparty. A supplier user with a
/// row here can never see another supplier's prices, and never sees anything
/// in the financing domain. A lender user never sees a SupplyOrder at all.
model CounterpartyAccess {
  id     String     @id @default(cuid())
  userId String     @unique
  scope  PartyScope

  supplierId String? // set when scope = SUPPLIER
  bankId     String? // set when scope = LENDER

  grantedAt DateTime  @default(now())
  grantedBy String?
  revokedAt DateTime?

  @@index([scope, supplierId])
  @@index([scope, bankId])
  @@map("counterparty_access")
}

// ------------------------------------------------------------
// The access rules, stated once so they are not reinvented per screen:
//
//  1. SUPPLIER scope   -> SupplyOrder WHERE supplierId = theirs. Never
//                         FinancingRequest, never Listing prices, never
//                         another supplier's anything.
//  2. LENDER scope     -> FinancingRequest for their own bank, plus the
//                         VEHICLE facts of the assigned unit: VIN, model,
//                         year, battery SoH, arrival date, inspection.
//                         NEVER SupplyOrder, supplier identity, or cost.
//  3. CUSTOMER scope   -> their own vehicle, loan, wallet, training.
//  4. INTERNAL scope   -> by role. Scorah: full supply chain. Cecilia:
//                         manufacturer sourcing only, no Exporter-kind
//                         suppliers — implemented as a filter on
//                         Supplier.kind, not as a separate system.
//
//  What a lender sees about a vehicle is CONDITION AND IDENTITY.
//  What a supplier sees about a vehicle is ORDER AND MONEY.
//  The VIN is common to both and is the only thing that is.
//
//  One consequence worth designing for deliberately: a vehicle should not be
//  assignable to a financed customer while balanceDueMinor > 0 AND
//  securityReleasedOn IS NULL — or if it is, the system should say so out
//  loud on the file, so nobody warrants "free of encumbrances" by accident.
// ------------------------------------------------------------

// ============================================================
// 10 · VEHICLE CLASSES AND FINANCE PRODUCTS
//
// Depends on: 01 (identity). Apply before 11 and 12.
//
// The programme was designed around one thing: a car, financed over three to five years,
// repaid from measured daily taxi net. The lender now wants electric bikes and trucks as
// well, and those are not cars with different numbers.
//
//   A bike is ~3.5M against ~27M, sells in dozens per week rather than units, repays over
//   twelve to twenty-four months, and is lost to theft rather than to accident. Its battery
//   may not even belong to the borrower.
//
//   A truck earns from contracts, not from daily fares. "Measured daily net" — the entire
//   basis of the readiness score — does not exist for freight, so it needs a different
//   evidence model or it should not be underwritten at all yet.
//
// Modelling all three as one product means every figure shown to the bank for two of them
// is wrong. So the terms become data.
// ============================================================

/// A kind of thing UZA finances. Reference data, not a per-unit record.
model VehicleClass {
  id   String @id @default(cuid())
  /// Short stable code used in refs and reporting: CAR, BIKE, TRIKE, TRUCK, BUS.
  code String @unique
  name String

  /// Whether repayment is evidenced by measured daily takings. False for freight, where
  /// income arrives per contract — and where the readiness score therefore cannot be
  /// computed the way it is for a taxi. See the note on TruckEvidence below.
  earnsDaily Boolean @default(true)

  /// Roughly how many fit in a 40ft high-cube, crated as UZA actually ships them. Used by
  /// consignment planning in migration 11; a planning figure, never a billing one.
  unitsPerContainer Int?

  /// True where the traction battery can be separated from the vehicle commercially —
  /// financed with it, or subscribed and swapped. On a two-year bike loan the battery
  /// residual is the largest single risk, and which way this goes changes the product,
  /// the insurance and what theft means. Left null until it is decided, deliberately.
  batterySeparable Boolean?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products FinanceProduct[]

  @@map("vehicle_classes")
}

/// A financing offer for one class, as agreed with one lender.
///
/// Versioned rather than edited. A file submitted in September must still be readable in
/// two years against the terms that actually applied to it — editing a live product in
/// place silently rewrites the history of every loan already written under it.
model FinanceProduct {
  id      String @id @default(cuid())
  /// e.g. UZM-FP-CAR-UNGUKA-V1
  ref     String @unique
  name    String
  classId String

  /// The lender these terms were agreed with. Null means UZA's own book.
  lenderName String?

  /// Client contribution, in basis points to avoid float drift on money maths.
  /// 1000 = 10%. The car product bands at 25,000,000: below it 10%, above it 15%.
  contributionBps     Int
  /// Set where a second band applies above a price threshold.
  contributionBpsHigh Int?
  bandThresholdRwf    BigInt?

  /// Tenor choices offered, in months. e.g. [36, 60] for a car, [12, 24] for a bike.
  tenorMonths Int[]

  /// Comprehensive cover as a percentage of vehicle value, in basis points. 550 = 5.5%.
  insuranceBps           Int
  /// Whether the premium may be added to the financed amount rather than paid up front.
  insuranceCapitalisable Boolean @default(true)

  /// UZA's cash collateral contribution, in basis points of the price. Released as
  /// principal is repaid and recycled into the next borrower — the number the whole
  /// programme's reach depends on.
  collateralBps Int @default(300)

  /// Floor on the client's own contribution regardless of percentage, in whole RWF.
  minContributionRwf BigInt?

  /// The interest rate is deliberately NOT a column here, and it is still never shown to
  /// a borrower — the founder's rule stands: a driver is told what they pay per day over
  /// three years or five, never a percentage.
  ///
  /// But the rate has to EXIST to compute that daily figure, and it is not one number.
  /// Unguka charges 34% a year to three years and 36% for four and five, so a single
  /// stored rate is wrong for half the tenors on offer. Hence `rateBands` below.
  rateBands FinanceProductRateBand[]

  version       Int       @default(1)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  active        Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class VehicleClass @relation(fields: [classId], references: [id])

  @@index([classId, active])
  @@index([lenderName])
  @@map("finance_products")
}

/// One interest band of a lender's schedule: a rate that applies up to a given tenor.
///
/// A separate table rather than two columns on the product, because the number of bands
/// is the lender's decision, not ours. Unguka has two (34% to 36 months, 36% to 60).
/// BK GO EV has two at different boundaries. A lender with one flat rate has one row.
///
/// Bands are read as "the lowest `maxTenorMonths` that still covers the requested tenor",
/// so they must not overlap. `resolveAnnualRateBps()` enforces that and refuses a tenor
/// no band covers rather than silently applying the highest — quoting a driver a rate the
/// lender never agreed to is worse than refusing to quote.
model FinanceProductRateBand {
  id        String @id @default(cuid())
  productId String

  /// Inclusive upper bound of the tenor this rate covers, in months. 36 = "up to 3 years".
  maxTenorMonths Int

  /// Annual nominal rate in basis points. 3400 = 34.00%. Integer, because money maths on
  /// a float drifts and a loan schedule is the last place that should happen.
  annualRateBps Int

  product FinanceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, maxTenorMonths])
  @@index([productId])
  @@map("finance_product_rate_bands")
}

/// How a battery is held for a given product. Only meaningful where the class allows it.
///
/// This is a product decision with a schema consequence, which is why it is an enum on the
/// product rather than a boolean somewhere: `financed` makes battery theft a credit event,
/// `subscription` makes it an operational one and shortens the loan.
enum BatteryModel {
  financed // part of the asset, part of the loan
  subscription // UZA owns it, the rider pays monthly and swaps
  undecided
}

/// Attached to a product rather than to a class, because the same bike could be offered
/// both ways to different segments.
model ProductBatteryTerms {
  id        String       @id @default(cuid())
  productId String       @unique
  model     BatteryModel @default(undecided)

  /// Monthly fee where model = subscription, whole RWF.
  monthlyFeeRwf BigInt?
  /// Swap stations the rider may use. Free text until the charging network models it.
  swapNetwork   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_battery_terms")
}

/// The evidence a freight borrower offers instead of daily takings.
///
/// Deliberately minimal and deliberately separate. Trucks should not be underwritten on the
/// taxi model, and the honest options are to build this properly or to defer the class —
/// both are fine, discovering the gap at the first application is not.
model FreightEvidence {
  id    String @id @default(cuid())
  ref   String @unique // e.g. UZM-FRE-2026-000012
  uzaId String // the borrower, via migration 01

  counterparty     String // who awards the contract
  contractValueRwf BigInt
  contractStart    DateTime
  contractEnd      DateTime?
  /// A scan or a signed copy. Null means the figure above is a claim, not evidence.
  documentUrl      String?
  verifiedById     String?
  verifiedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uzaId])
  @@index([counterparty])
  @@map("freight_evidence")
}

// ============================================================
// 11 · CONSIGNMENTS AND ALLOCATION
//
// Depends on: 01 (identity), 09 (supply), 10 (classes). Apply before 12.
//
// At eight vehicles, allocation is a WhatsApp message. At sixty units a week it is a queue
// with rules, and the first time a driver who paid their contribution in July watches
// someone who applied in September ride away, the programme has a reputation problem that
// no amount of explaining fixes.
//
// So allocation becomes a record with a reason attached. Every promise of a specific unit
// to a specific person is written down, in order, with who made it and why — including
// when the order is deliberately overridden, which happens and is fine as long as it is
// visible.
// ============================================================

enum ConsignmentStatus {
  planned // ordered, not yet loaded
  loaded
  in_transit
  arrived_port
  cleared
  at_yard
  distributed
}

/// One container, or one road/RoRo movement. The unit UZA actually plans in.
model Consignment {
  id     String            @id @default(cuid())
  ref    String            @unique // e.g. UZM-CNS-2026-000041
  status ConsignmentStatus @default(planned)

  /// Which supplier and agreement it came from — migration 09.
  supplyOrderRef String?
  containerNo    String?
  vesselOrTruck  String?

  originPort      String?
  destinationPort String?

  /// Planned dates first, actuals as they happen. Both kept: the gap between them is the
  /// only honest input to the next plan's lead time.
  etdPlanned DateTime?
  etaPlanned DateTime?
  etdActual  DateTime?
  etaActual  DateTime?
  clearedAt  DateTime?

  /// Declared totals. Verified against the packing list by François from September —
  /// understated CBM is discovered at the port, when it is expensive.
  declaredWeightKg Int?
  declaredCbm      Float?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units ConsignmentUnit[]

  @@index([status])
  @@index([etaPlanned])
  @@map("consignments")
}

enum UnitStatus {
  in_consignment
  at_yard
  allocated // promised to a named person
  registered // ownership transferred
  delivered
  returned
}

/// One physical thing — a car, a bike, a truck — inside a consignment.
///
/// `vin` is nullable because bikes frequently arrive with a frame number rather than a
/// seventeen-character VIN, and forcing one produces invented data. `identifier` always
/// holds whatever actually identifies the unit.
model ConsignmentUnit {
  id            String @id @default(cuid())
  ref           String @unique // e.g. UZM-UNT-2026-000913
  consignmentId String
  classCode     String // VehicleClass.code — CAR, BIKE, TRUCK

  identifier String  @unique // VIN, frame number, or chassis number
  vin        String?
  make       String?
  model      String?
  colour     String?
  batteryNo  String? // where the battery is separable and tracked in its own right

  status UnitStatus @default(in_consignment)

  /// Landed cost in whole RWF, filled once freight and duty are known. Not a price.
  landedCostRwf BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consignment Consignment  @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  allocations Allocation[]

  @@index([consignmentId])
  @@index([status])
  @@index([classCode, status])
  @@map("consignment_units")
}

enum AllocationStatus {
  queued
  promised // a specific unit is held for this person
  confirmed // they have accepted it
  declined
  fulfilled
  lapsed // they did not respond in time and went back in the queue
}

/// A person's place in the line for a class of vehicle.
///
/// `position` is not stored — a stored rank goes stale the moment anyone is inserted or
/// removed, and then two screens disagree about who is next. Order is derived at read time
/// from `readyAt`, and `priorityReason` records every deliberate departure from it.
model AllocationQueue {
  id        String @id @default(cuid())
  ref       String @unique // e.g. UZM-AQ-2026-000188
  uzaId     String // the applicant, via migration 01
  classCode String

  /// When they became genuinely ready — contribution paid, training complete, bank file
  /// approved. NOT when they applied. Queue order that rewards early enquiry rather than
  /// readiness is how a paid-up applicant ends up behind someone who is not.
  readyAt DateTime

  /// A stated preference. Recorded because ignoring it silently is worse than not asking,
  /// and because a driver who insists on one model may reasonably wait longer.
  preferredMake  String?
  preferredModel String?

  /// Set only when someone is moved out of readiness order. Required by the service, so
  /// jumping the queue is always possible and never invisible.
  priorityReason  String?
  prioritisedById String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations Allocation[]

  @@unique([uzaId, classCode]) // one place in the line per class per person
  @@index([classCode, readyAt])
  @@map("allocation_queue")
}

/// A specific unit promised to a specific person, with a clock on it.
model Allocation {
  id      String           @id @default(cuid())
  ref     String           @unique // e.g. UZM-ALC-2026-000204
  unitId  String
  queueId String
  status  AllocationStatus @default(promised)

  promisedAt  DateTime  @default(now())
  /// How long the promise holds. A unit reserved indefinitely for someone who has stopped
  /// answering is a unit not earning, so the offer expires and the queue moves on.
  expiresAt   DateTime
  respondedAt DateTime?
  fulfilledAt DateTime?

  /// Why it was declined or allowed to lapse. Feeds the next plan: a make nobody accepts
  /// is a sourcing error, not a customer problem.
  outcomeNote String?

  decidedById String? // the employee who made the promise

  /// Mirrors `unitId` while the promise is live (promised or confirmed) and is set to NULL
  /// the moment it ends. Unique, so a unit cannot be held by two people at once — and
  /// because Postgres permits many NULLs, any number of people may have previously
  /// declined the same unit, which is normal and must stay possible.
  ///
  /// A plain `@@unique([unitId, status])` would have been wrong: it enforces one promise
  /// per unit, but it also silently forbids a second person ever declining a unit somebody
  /// already declined. The service sets and clears this column on every status change.
  activeHoldUnitId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit  ConsignmentUnit @relation(fields: [unitId], references: [id])
  queue AllocationQueue @relation(fields: [queueId], references: [id])

  @@index([unitId])
  @@index([queueId])
  @@index([expiresAt])
  @@map("allocations")
}

// ============================================================
// 12 · BANK FILE ASSEMBLY
//
// Depends on: 01 (identity), 03 (academy), 05 (readiness), 10 (products), 11 (allocation).
// Apply last.
//
// Eleven documents per applicant. At sixty units a week that is 693 documents a week, and
// no number of officers makes that work — two more people doubles the throughput and
// doubles the error rate.
//
// The way out is that most of those eleven are not documents at all. They are facts the
// platform already holds: who the person is, what they scored, what they contributed, which
// VIN they were allocated, what the product terms were on the day. Only a handful are
// genuinely external — an ID scan, a licence, a CRB report. So the file is generated, the
// external items are attached, and the officer's job becomes checking rather than
// collecting.
// ============================================================

enum BankFileStatus {
  building // items still outstanding
  ready // everything present, not yet sent
  submitted
  queried // the lender came back with a question
  approved
  declined
  withdrawn
}

/// Where an item comes from. This is the field that decides whether volume is possible:
/// `generated` items cost nothing per file, `uploaded` ones cost a person's attention.
enum ItemSource {
  generated // produced from records the platform already holds
  uploaded // a human had to obtain and attach it
  external // fetched from a third party, e.g. a credit reference
}

/// One applicant's submission to one lender for one allocated unit.
model BankFile {
  id     String         @id @default(cuid())
  ref    String         @unique // e.g. UZM-BF-2026-000451
  status BankFileStatus @default(building)

  uzaId         String // the applicant, via migration 01
  lenderName    String
  productRef    String // FinanceProduct.ref — the terms as at submission
  allocationRef String? // the unit promised to them, via migration 11

  /// The commercial shape at the moment of submission, copied rather than referenced.
  /// A file must remain readable in two years against the numbers that actually applied,
  /// and product terms are versioned precisely because they change.
  pricePaidRwf      BigInt?
  contributionRwf   BigInt?
  insuranceRwf      BigInt?
  financedAmountRwf BigInt?
  tenorMonths       Int?

  /// Copied from the readiness snapshot that was current when the file was built —
  /// migration 05 keeps those immutable for exactly this reason.
  readinessScoreRef String?

  submittedAt   DateTime?
  decidedAt     DateTime?
  /// The lender's own reference, so a query from them can be found without searching.
  lenderRef     String?
  declineReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    BankFileItem[]
  events   BankFileEvent[]
  packages BankPackage[]

  @@index([status])
  @@index([uzaId])
  @@index([lenderName, status])
  @@map("bank_files")
}

/// One published, immutable copy of the bank-ready PDF for one file.
///
/// A lender must be able to be shown, months later, exactly the document that was
/// published on a given day — not a re-render from whatever the database says now. So
/// this is append-only: `publish()` never updates a row here, it inserts the next
/// version. `itemsSnapshot` freezes the checklist as it stood at publish time for the
/// same reason `BankFile`'s own commercial fields are copied rather than referenced (see
/// its own doc comment above) — the source rows can keep moving after this is signed.
model BankPackage {
  id         String @id @default(cuid())
  ref        String @unique // e.g. UZM-BF-2026-000451-v3
  bankFileId String
  version    Int

  /// Where the rendered PDF lives — StorageService's public URL, same convention as
  /// every other generated document in this codebase (see FleetPdfStorageService).
  storageUrl     String
  checksumSha256 String
  byteSize       Int

  /// Each item's code/label/source/present/documentUrl at the moment this version was
  /// published, so a dispute six months later can be settled against what was actually
  /// sent rather than against today's row.
  itemsSnapshot Json

  publishedById String?
  publishedAt   DateTime @default(now())

  file BankFile @relation(fields: [bankFileId], references: [id], onDelete: Cascade)

  @@unique([bankFileId, version])
  @@index([bankFileId])
  @@map("bank_packages")
}

/// One of the eleven, in one file.
///
/// Rows are created for every required item as soon as the file opens, `present = false`.
/// A file is `ready` when none remain outstanding — which makes "what is missing" a query
/// rather than a person's memory, and makes the weekly bottleneck visible by item type.
model BankFileItem {
  id         String     @id @default(cuid())
  bankFileId String
  /// Stable code so reporting survives a wording change: NATIONAL_ID, DRIVING_LICENCE,
  /// CRB_REPORT, TRAINING_CERTIFICATE, READINESS_SCORE, INCOME_EVIDENCE, CONTRIBUTION_PROOF,
  /// PROFORMA, INSURANCE_QUOTE, VEHICLE_ALLOCATION, APPLICATION_FORM.
  code       String
  label      String
  source     ItemSource

  present      Boolean   @default(false)
  /// Where the artefact lives. Null for a generated item that is rendered on demand.
  documentUrl  String?
  generatedAt  DateTime?
  uploadedById String?
  uploadedAt   DateTime?

  /// A second pair of eyes, required only on items where a mistake is expensive — the
  /// CRB report and the contribution proof. Left null elsewhere rather than performing a
  /// check nobody actually does.
  verifiedById String?
  verifiedAt   DateTime?

  /// Set when the lender queries this specific item, so a re-submission goes straight to
  /// what was wrong instead of resending everything.
  queryNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  file BankFile @relation(fields: [bankFileId], references: [id], onDelete: Cascade)

  @@unique([bankFileId, code])
  @@index([code, present])
  @@map("bank_file_items")
}

/// An append-only history of what happened to the file.
///
/// Separate from `updatedAt` because the question a lender asks six months later is not
/// "when did this change" but "who sent it, when, and what did we say" — and a mutable row
/// cannot answer that.
model BankFileEvent {
  id         String   @id @default(cuid())
  bankFileId String
  at         DateTime @default(now())
  actorId    String?
  /// opened, item_added, item_verified, marked_ready, package_published, submitted,
  /// queried, resubmitted, approved, declined, withdrawn
  kind       String
  detail     String?

  file BankFile @relation(fields: [bankFileId], references: [id], onDelete: Cascade)

  @@index([bankFileId, at])
  @@map("bank_file_events")
}

/// The lender's own volume commitment, recorded so throughput can be planned against it.
///
/// UZA's constraint is now operational rather than financial, but that only holds while the
/// commitment holds. Writing it down means the day it changes is visible immediately rather
/// than discovered when a file is declined.
model LenderCommitment {
  id         String @id @default(cuid())
  ref        String @unique // e.g. UZM-LC-2026-0001
  lenderName String
  classCode  String // which class the commitment covers

  /// Units the lender has said it will finance in the period. The number that sizes
  /// sourcing, staffing and every system in this pack.
  unitsCommitted Int
  periodStart    DateTime
  periodEnd      DateTime

  /// Whether it exists on paper. A verbal commitment is worth planning around and is not
  /// worth financing against, and the distinction should be one column rather than an
  /// argument.
  documented  Boolean @default(false)
  documentUrl String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lenderName, classCode])
  @@map("lender_commitments")
}

// ============================================================
// 13 · THE CANDIDATE JOURNEY
//
// Depends on: 01 (identity), 03 (academy), 05 (readiness), 12 (bank file).
//
// A person does not arrive as a borrower. They arrive as somebody a bank has looked at and
// set aside, and the programme's entire job is to move them — visibly, in a way both they
// and the lender can watch — from that to funded.
//
// Two things this must get right, and both come from the nexus rather than from intuition.
//
// FIRST: THE GAP IS ELIGIBILITY, NOT LOAN-TO-VALUE.
// Bank of Kigali already offers 100% EV financing with no deposit to private buyers, and
// I&M offers collateral-free EV financing. Nobody needs persuading to lend more. What BK's
// taxi terms actually require is a registered business with twelve months of trading
// history, fleet-app integration, fare settlement into a bank account and a GPS tracker —
// none of which an informal driver has. So screening records WHICH criteria a person fails,
// one row each, and the programme closes them one at a time. A model that only tracked
// "contribution short" would describe the wrong problem and produce the wrong programme.
//
// SECOND: DECLINING IS A STAGE, NOT AN ENDING.
// Status 12 — advised to build further before borrowing — is a legitimate outcome and the
// Drivers Pool is a success, not a consolation. A programme with 100% loan conversion is
// screening nobody, and a funder will see that before UZA does. So the schema makes the
// "advised not to borrow" count reportable, and refuses to record a decline without a
// remediation path.
// ============================================================

/// Where a candidate came from.
///
/// The cohort is deliberately mixed. Unguka refers people it has already screened and set
/// aside; UZA recruits others. They train together, which matters twice over — the bank sees
/// its own referrals succeed alongside strangers, and UZA is not building a programme that
/// only works for one lender's rejects.
enum IntakeSource {
  LENDER_REFERRAL // a lender screened them and could not fund them yet
  UZA_RECRUITED
  ASSOCIATION // a moto or taxi association put them forward
  WALK_IN
  RETURNING // exited a previous cohort and came back
}

/// The canonical pipeline from 05-portal-spec.md §3. These are the exact stages; do not
/// invent variants, and do not renumber. Statuses hidden on non-collateral tenants are
/// marked, and the tenant wall removes them from the response entirely rather than hiding
/// them in the interface.
enum JourneyStage {
  REGISTERED //  1
  SCREENING //  2
  ENROLLED //  3  cohort assigned
  TRAINING_IN_PROGRESS //  4
  SAVINGS_RECORD_BUILDING //  5  day X of 90
  ASSESSMENT_SCHEDULED //  6
  ASSESSMENT_PASSED //  7
  REASSESSMENT_REQUIRED //  8
  CERTIFIED //  9
  READINESS_SCORE_PUBLISHED // 10
  PLACED_IN_DRIVERS_POOL // 11
  ADVISED_TO_BUILD_FURTHER // 12  a real outcome, not a failure
  VEHICLE_SELECTED // 13
  APPLICATION_SUBMITTED // 14
  LENDER_DOCUMENTS_REQUESTED // 15
  LENDER_UNDER_REVIEW // 16
  LENDER_INTERVIEW_SCHEDULED // 17
  LENDER_APPROVED_IN_PRINCIPLE // 18
  LENDER_CONDITIONS_TO_SATISFY // 19
  LENDER_DECLINED // 20  reason code + remediation path required
  COLLATERAL_REQUESTED // 21  hidden outside the collateral tenant
  COLLATERAL_POSTED // 22  hidden outside the collateral tenant
  INSURANCE_QUOTE_REQUESTED // 23
  INSURANCE_QUOTED // 24
  INSURANCE_POLICY_ISSUED // 25
  VEHICLE_ORDERED // 26
  VEHICLE_IN_TRANSIT // 27
  VEHICLE_CUSTOMS // 28
  VEHICLE_REGISTERED // 29
  VEHICLE_DELIVERED // 30
  LOAN_DISBURSED // 31
  REPAYMENT_ACTIVE // 32
  PAYMENT_DUE_SOON // 33
  ARREARS // 34
  SUPPORT_REQUESTED // 35
  RESTRUCTURE_UNDER_DISCUSSION // 36
  COLLATERAL_TRANCHE_ELIGIBLE // 37 hidden outside the collateral tenant
  COLLATERAL_RELEASED // 38 hidden outside the collateral tenant
  LOAN_CLOSED // 39
  EXITED_PROGRAMME // 40 reason code required
}

/// One person's passage through the programme. One row per person per cohort attempt.
/// A taxi driver's application to the UZA Empower fund.
///
/// This is the FORM. `CandidateJourney` is what happens afterwards — the two are separate
/// because an application is a signed statement made at one moment, and a journey is a
/// thing that changes. Editing an application after signature would rewrite what somebody
/// put their name to, so the answers are written once and corrections are new rows.
///
/// ── WHAT THE FIELDS ARE FOR ───────────────────────────────────────────────────────────
///
/// Every question maps to something. Most map to a `GapKind`, so screening is derived from
/// the answers rather than typed in again by staff — see `screenApplication()`. A question
/// that maps to nothing was not asked.
///
/// ── PERSONAL DATA ─────────────────────────────────────────────────────────────────────
///
/// National ID and phone are sensitive under Law N° 058/2021. They are stored because the
/// bank requires identity verification, and they are NEVER included in any lender-facing
/// payload — a lender receives a UZA ID and a display name. See `lender-access.ts`.
model FundApplication {
  id  String @id @default(cuid())
  ref String @unique // UZM-APP-2026-000001

  /// Set once the applicant is resolved to a person. Null while the form is a draft.
  uzaId String?

  status FundApplicationStatus @default(DRAFT)

  // --- Identity -----------------------------------------------------------------
  fullName       String
  nationalId     String
  dateOfBirth    DateTime? @db.Date
  gender         Gender?
  phone          String
  alternatePhone String?
  district       String
  sector         String?
  cell           String?

  // --- Driving ------------------------------------------------------------------
  /// Maps to GapKind.LICENCE_OR_PERMIT when absent or expired.
  licenceNumber   String?
  licenceCategory String?
  licenceExpiry   DateTime?            @db.Date
  yearsDriving    Int?
  /// Owns / rents / drives for an employer. Decides whether a trade-in is possible and
  /// whether the applicant currently pays a daily rental they would stop paying.
  currentVehicle  VehicleRelationship?
  currentPlate    String?
  /// Maps to GapKind.LICENCE_OR_PERMIT and to the association referral route.
  associationName String?

  // --- Income, in whole RWF -----------------------------------------------------
  /// Maps to GapKind.NO_VERIFIABLE_INCOME. Self-declared at this stage and labelled as
  /// such everywhere it is shown — it becomes verified only once the wallet has a record.
  averageDailyTakingsRwf Int?
  workingDaysPerWeek     Int?
  /// What renting currently costs them. The number that makes ownership comparable.
  currentDailyRentalRwf  Int?
  otherMonthlyIncomeRwf  Int?
  dependants             Int?

  // --- Savings and banking ------------------------------------------------------
  /// Maps to GapKind.CONTRIBUTION_SHORT once a product's required contribution is known.
  currentSavingsRwf        Int?
  savingsHeldAt            SavingsLocation?
  monthlySavingCapacityRwf Int?
  /// Maps to GapKind.NO_BANK_FARE_SETTLEMENT.
  hasBankAccount           Boolean          @default(false)
  bankName                 String?
  mobileMoneyNumber        String?
  /// Maps to GapKind.THIN_CREDIT_FILE.
  hasBorrowedBefore        Boolean          @default(false)
  currentlyRepayingLoan    Boolean          @default(false)
  currentLoanDetail        String?

  // --- What they are applying for ------------------------------------------------
  cohortId             String?
  preferredTenorMonths Int?
  depositAvailableRwf  Int?
  /// Which lender the applicant is being put forward to, if already decided.
  preferredLenderKey   String?

  // --- Declaration and consent ----------------------------------------------------
  /// The applicant states the answers are true. Without this the form is not submitted.
  declarationAccepted        Boolean @default(false)
  /// Consent to share the file with the named lender. Separate from the declaration on
  /// purpose: agreeing your answers are true is not agreeing a bank may read them.
  lenderConsentGiven         Boolean @default(false)
  /// Consent to the training and inspection record being kept. Also separate.
  dataProcessingConsentGiven Boolean @default(false)

  /// How the form was completed. `ASSISTED` means a staff member read it aloud and
  /// recorded the answers — which is a different evidentiary position to self-service and
  /// must be visible as such.
  completionMode FormCompletionMode @default(SELF_SERVICE)
  assistedByRef  String?

  /// Signature: who signed, when, and where the image lives. `signatureRef` points at
  /// GridFS; the image itself never goes in Postgres.
  signedAt     DateTime?
  signatureRef String?
  witnessName  String?
  witnessRef   String?

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  cohort Cohort? @relation(fields: [cohortId], references: [id])

  /// Consents signed on this application, before a UZA ID exists to hang them on.
  lenderConsents LenderConsent[]

  @@index([status])
  @@index([uzaId])
  @@index([cohortId])
  @@index([nationalId])
  @@map("fund_applications")
}

enum FundApplicationStatus {
  DRAFT
  SUBMITTED
  SCREENING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum VehicleRelationship {
  OWNS
  RENTS
  DRIVES_FOR_EMPLOYER
  NONE
}

enum SavingsLocation {
  BANK
  SACCO
  MOBILE_MONEY
  CASH_AT_HOME
  NONE
}

enum FormCompletionMode {
  SELF_SERVICE
  /// Read aloud and recorded by a staff member, in Kinyarwanda. The programme is designed
  /// for oral-first delivery so that formal schooling is not a barrier to participation.
  ASSISTED
}

enum Gender {
  FEMALE
  MALE
  PREFER_NOT_TO_SAY
}

model CandidateJourney {
  id    String       @id @default(cuid())
  ref   String       @unique // e.g. UZM-CJ-2026-000042
  uzaId String // the person, via migration 01
  stage JourneyStage @default(REGISTERED)

  intakeSource IntakeSource
  /// Which lender referred them, when the source is a referral. Recorded because a lender
  /// wants to see how ITS OWN referrals fared, and because that comparison is the argument
  /// for the whole programme.
  referredBy   String?
  referredOn   DateTime?

  cohortId String?
  cohort   Cohort? @relation(fields: [cohortId], references: [id])

  /// Set when the journey ends, either way. `EXITED_PROGRAMME` and
  /// `ADVISED_TO_BUILD_FURTHER` both require one.
  outcomeReason   String?
  /// What would change the answer. Required alongside a decline — a candidate must never be
  /// told no without being told what would make it a yes.
  remediationPath String?

  startedAt   DateTime  @default(now())
  stagedAt    DateTime  @default(now()) // when the current stage was entered
  completedAt DateTime?

  events JourneyEvent[]
  gaps   EligibilityGap[]

  @@unique([uzaId, cohortId])
  @@index([stage])
  @@index([intakeSource, stage])
  @@index([referredBy])
  @@map("candidate_journeys")
}

/// Immutable. Who moved it, when, from where to where, and why.
///
/// Separate from `stagedAt` on the journey because the question a lender asks six months
/// later is not "what stage is this" but "how long did it sit at screening, and who moved
/// it" — and a mutable column cannot answer that.
model JourneyEvent {
  id        String        @id @default(cuid())
  journeyId String
  at        DateTime      @default(now())
  fromStage JourneyStage?
  toStage   JourneyStage
  actorId   String? // null when the system moved it
  note      String?

  journey CandidateJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId, at])
  @@map("journey_events")
}

/// What a lender's own criteria say is missing.
///
/// This is the heart of the programme. Each row is one reason this person is not yet
/// fundable, recorded at screening by the lender's staff or by UZA, and closed when the
/// programme fixes it. The list of kinds mirrors what BK GO EV actually requires of a taxi
/// operator, because that is the real eligibility bar and not a hypothesis about one.
enum GapKind {
  CONTRIBUTION_SHORT // has some savings, not the full required contribution
  NO_BUSINESS_REGISTRATION // BK requires a registered business
  INSUFFICIENT_TRADING_HISTORY // BK requires 12+ months
  NO_FLEET_APP // Yego / Move / Greenride / Tap&Go integration
  NO_BANK_FARE_SETTLEMENT // fares must settle into a bank account
  NO_GPS_TRACKER
  NO_VERIFIABLE_INCOME // the thing the placement programme produces
  THIN_CREDIT_FILE // no borrowing history to underwrite against
  DOCUMENTS_INCOMPLETE // ID, licence, residence
  LICENCE_OR_PERMIT // taxi licence, RURA authorisation
  OTHER
}

/// Who says it is closed. A gap UZA declares closed and the lender disputes is worse than
/// an open one, so the closer is recorded.
enum GapStatus {
  OPEN
  IN_PROGRESS
  CLOSED_BY_PROGRAMME // training, savings, placement or documentation fixed it
  CLOSED_BY_CANDIDATE // they resolved it themselves
  WAIVED_BY_LENDER // the lender accepted the file without it
  NOT_CLOSEABLE // structural, and the honest answer is a different product or a decline
}

model EligibilityGap {
  id        String    @id @default(cuid())
  journeyId String
  kind      GapKind
  status    GapStatus @default(OPEN)

  /// Free text from whoever screened. Kept because "12+ months trading" and "no receipts for
  /// the last four months" are different problems with the same enum.
  detail String?

  /// Where the gap is a shortfall in money, how much. Whole RWF. Null for everything else —
  /// a missing GPS tracker has no amount and inventing one would make the reporting lie.
  shortfallRwf BigInt?

  /// Who raised it. A gap raised by the lender carries more weight than one UZA guessed at,
  /// and the difference should survive into the reporting.
  raisedBy     String?
  raisedByRole String? // "lender" | "uza" | "candidate"
  raisedAt     DateTime @default(now())

  closedBy    String?
  closedAt    DateTime?
  /// How it was closed. This is the evidence the programme actually works, one row at a time.
  closureNote String?

  journey CandidateJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@unique([journeyId, kind])
  @@index([status])
  @@index([kind, status])
  @@map("eligibility_gaps")
}

/// A screening decision by a lender's staff or by UZA.
///
/// Deliberately separate from the gaps it produces. The screening is an event with a date
/// and a person attached; the gaps are the findings. Keeping them apart means a re-screen
/// three months later can be compared against the first one, which is exactly the evidence
/// a lender needs to believe the programme changes anything.
model Screening {
  id        String @id @default(cuid())
  ref       String @unique // e.g. UZM-SCR-2026-000117
  journeyId String

  screenedBy    String // the person
  screenedByOrg String // "LOLC Unguka" | "UZA" — who is making the judgement
  screenedAt    DateTime @default(now())

  /// The screener's own view, before any programme intervention. Not a score — a judgement.
  fundableToday       Boolean
  /// The sentence that matters: fundable as a person, but for what?
  fundableInPrinciple Boolean @default(true)
  summary             String?

  /// Set on a re-screen so the pair can be compared.
  previousScreeningId String?

  @@index([journeyId, screenedAt])
  @@index([screenedByOrg])
  @@map("screenings")
}

// ============================================================
// SECTION 30 — WORKSHOP & LENDER LOAN SERVICING
//
// Wires src/modules/workshop/*.ts and src/modules/financing/loan-terms.ts — both fully
// written and unit-tested already — to real persistence. Neither had a database table
// before this section, so neither could be reached over HTTP even once a controller
// existed. Enum values mirror the pure-logic modules exactly; see those files for the
// reasoning behind each state and gate. Persisted here, not re-derived, so a job card's
// history survives the process restarting.
// ============================================================

enum WorkCategory {
  BRAKES
  STEERING
  SUSPENSION
  TYRES
  HIGH_VOLTAGE
  BODY
  GENERAL
}

enum JobCardState {
  BOOKED
  RECEIVED
  DIAGNOSING
  ESTIMATED
  AWAITING_AUTHORISATION
  AUTHORISED
  IN_PROGRESS
  ADDITIONAL_WORK_FOUND
  AWAITING_PARTS
  WORK_COMPLETE
  QUALITY_CHECK
  ROAD_TEST
  READY_FOR_HANDOVER
  HANDED_OVER
  CLOSED
  DECLINED
  CANCELLED
}

enum MechanicEngagement {
  /// UZA employee, in a UZA workshop, at a UZA-set price. See mechanic-pool.ts -- this is
  /// the arm everything a lender has been promised about a financed vehicle runs through.
  EMPLOYED
  /// Independent partner, own premises, own price. UZA certifies the work and takes a
  /// commission; UZA must never set this person's price (mechanic-pool.ts explains why).
  CERTIFIED
}

enum MechanicLevel {
  APPRENTICE
  TECHNICIAN
  SENIOR
  MASTER
}

enum RescueStatus {
  REQUESTED
  DISPATCHED
  EN_ROUTE
  ON_SITE
  COMPLETED
  /// dispatch() in rescue-dispatch.ts returned null -- nobody eligible was available. A
  /// real operational outcome, not an error, and it must be visible on the call itself.
  NO_RESPONDER_AVAILABLE
  CANCELLED
}

/// Mirrors LoanStatus in uza-mobility-fn's src/types/lender/portfolio.ts exactly -- the
/// two are not allowed to drift, since a status the frontend cannot render is worse than
/// one it renders as an unknown string.
enum LoanStatus {
  PENDING
  IN_REVIEW
  APPROVED
  DECLINED
  DISBURSED
  ACTIVE
  IN_ARREARS
  CLOSED
}

enum CollateralEntryKind {
  PLEDGED
  RELEASED
  CALLED_BACK
}

model Mechanic {
  id     String  @id @default(cuid())
  /// The UZA ID, where this person also has one elsewhere in the estate. Nullable: an
  /// independent certified partner may exist here before ever touching another system.
  uzaId  String?
  /// Set only for EMPLOYED technicians who also have a marketplace/staff account. A
  /// CERTIFIED partner is a business relationship, not necessarily a login.
  userId String? @unique
  name   String

  engagement     MechanicEngagement
  level          MechanicLevel
  certifiedFor   WorkCategory[]
  certifiedUntil DateTime
  /// Set when certification is withdrawn. mechanic-pool.ts: a suspended partner is not
  /// dispatchable, full stop -- checked ahead of everything else in eligibility.
  suspendedAt    DateTime?
  available      Boolean            @default(true)
  /// 0-5, from completed rescues. Used only to break a near-tie on distance.
  rating         Float              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User?               @relation(fields: [userId], references: [id])
  performedJobs   JobCard[]           @relation("JobCardPerformedBy")
  checkedJobs     JobCard[]           @relation("JobCardCheckedBy")
  rescueResponses RescueCall[]        @relation("RescueResponder")
  inspections     VehicleInspection[]

  @@index([engagement, level])
  @@map("mechanics")
}

/// One vehicle's visit, end to end. state only ever moves along the edges in
/// job-card.state.ts's TRANSITIONS map -- the service layer calls assertTransition()
/// before every write here, so an illegal state is a 4xx, never a row in this table.
model JobCard {
  id           String         @id @default(cuid())
  reference    String         @unique
  vin          String?
  vehiclePlate String?
  state        JobCardState   @default(BOOKED)
  categories   WorkCategory[]

  /// What the customer was told. The commitment, not an estimate -- workshop-board.ts
  /// ranks a job OVERDUE the moment this passes, however busy the workshop is.
  promisedAt   DateTime
  receivedAt   DateTime?
  handedOverAt DateTime?

  /// Set when the customer has authorised the CURRENT scope, including any additions.
  /// Gate 1 in job-card.state.ts refuses IN_PROGRESS without this (rework returning from
  /// QC/road-test is the documented exception).
  authorisedAt          DateTime?
  performedByMechanicId String?
  /// Must differ from performedByMechanicId -- Gate 2, enforced in the service layer, not
  /// just here, because a unique constraint cannot express "different from that other row".
  checkedByMechanicId   String?
  qualityCheckPassed    Boolean?
  roadTestCompleted     Boolean?

  /// For workshop-kpi.ts: true when this job needed rework after failing its own QC.
  failedQualityCheck Boolean @default(false)
  /// Any high-voltage incident is reportable individually -- workshop-kpi.ts deliberately
  /// never averages this into a rate.
  safetyIncidents    Int     @default(0)

  /// needsReauthorisation() in job-card.state.ts compares these two directly.
  authorisedTotalMinor Int?
  currentTotalMinor    Int?

  customerUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  performedBy Mechanic? @relation("JobCardPerformedBy", fields: [performedByMechanicId], references: [id])
  checkedBy   Mechanic? @relation("JobCardCheckedBy", fields: [checkedByMechanicId], references: [id])
  customer    User?     @relation("JobCardCustomer", fields: [customerUserId], references: [id])

  @@index([state])
  @@index([promisedAt])
  @@map("job_cards")
}

/// A roadside breakdown and the dispatch decision made for it. responderId is null
/// exactly when status is NO_RESPONDER_AVAILABLE -- dispatch() returning null is a real
/// answer, not a failure to record.
model RescueCall {
  id        String       @id @default(cuid())
  reference String       @unique
  category  WorkCategory
  status    RescueStatus @default(REQUESTED)

  /// Snapshot at dispatch time, from the Responder the pure function chose. Not
  /// recomputed later -- the reason a particular partner was sent must stay legible even
  /// after they have moved or a closer one has since joined the pool.
  distanceKm Float?
  reason     String?

  responderId     String?
  /// The referral commission UZA earns on this job -- referralCommission() in
  /// rescue-dispatch.ts. Null until the job value is known.
  jobValueMinor   Int?
  commissionMinor Int?

  requestedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responder   Mechanic? @relation("RescueResponder", fields: [responderId], references: [id])
  requestedBy User?     @relation("RescueRequestedBy", fields: [requestedById], references: [id])

  @@index([status])
  @@map("rescue_calls")
}

/// A real, disbursed loan against a financed vehicle -- as distinct from FinancingRequest,
/// which is UZA facilitating a buyer's paperwork before any lender has agreed to anything.
/// A Loan exists once a bank has actually approved and (usually) disbursed. annualRateBps
/// is stored for reconciliation only -- loan-terms.ts is explicit that a borrower is never
/// shown a percentage, so nothing in the lender or buyer UI should render this field raw.
model Loan {
  id                 String  @id @default(cuid())
  reference          String  @unique
  financingRequestId String? @unique
  bankId             String
  borrowerUserId     String

  /// The vehicle's total price. Present so the equity gap -- what the bank asks the buyer
  /// to contribute, typically 10-20% -- is a number this schema can show, not something
  /// left to be reconstructed from a WhatsApp thread. Null on loans booked before this
  /// field existed, or where the price genuinely was never recorded here.
  vehiclePriceRwf       Int?
  /// The buyer's own cash toward that price -- NOT the loan principal, which is what the
  /// bank lends on top of this. UZA Empower's equity top-up is never stored as a separate
  /// number here: it is the sum of this loan's PLEDGED CollateralEntry rows (see below),
  /// because a ledger of what actually moved is more trustworthy than a field somebody
  /// could edit -- the same reasoning CollateralEntry itself already documents.
  clientContributionRwf Int?

  principalRwf      Int
  tenorMonths       Int
  annualRateBps     Int
  monthlyRwf        Int
  dailyRwf          Int
  totalRepayableRwf Int
  outstandingRwf    Int
  arrearsRwf        Int        @default(0)
  status            LoanStatus @default(PENDING)
  disbursedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bank              Bank                @relation(fields: [bankId], references: [id])
  borrower          User                @relation("LoanBorrower", fields: [borrowerUserId], references: [id])
  financingRequest  FinancingRequest?   @relation(fields: [financingRequestId], references: [id])
  collateralEntries CollateralEntry[]
  inspections       VehicleInspection[]
  savingsEntries    LoanSavingsEntry[]
  /// The structured back-and-forth trail once a loan is with a bank — see LenderDecision,
  /// InfoRequest and CreditNote below. Anchored here rather than on FinancingRequest
  /// because `Loan` (scoped by bankId) is what `LenderService`/`LenderController` already
  /// operate on for everything else a bank does with its own book.
  lenderDecisions   LenderDecision[]
  infoRequests      InfoRequest[]
  creditNotes       CreditNote[]
  /// The financed vehicle itself -- chassis/VIN, make/model, color. Deliberately its own
  /// model rather than reusing ManagedVehicle: ManagedVehicle is UZA's own fleet (an
  /// ownerUserId UZA controls, a ManagementAgreement, DriverAssignments) -- a vehicle a
  /// driver is financing and will own outright is a different fact than one UZA leases
  /// them, and collapsing the two would make ManagedVehicle's fleet-ops fields ambiguous.
  vehicle           LoanVehicle?
  /// Every tenor change (e.g. 36 <-> 60 months) ever applied, oldest first. Loan's own
  /// tenorMonths/monthlyRwf/dailyRwf/totalRepayableRwf/outstandingRwf always reflect the
  /// CURRENT terms; this is the append-only history of how they got there, mirroring why
  /// LenderDecision exists instead of only overwriting Loan.status.
  tenorChanges      LoanTenorChange[]
  /// Change requests raised against this loan (by a lender or UZA staff) that require a
  /// second person's sign-off before they take effect -- see LoanChangeRequest.
  changeRequests    LoanChangeRequest[]

  @@index([bankId, status])
  @@map("loans")
}

/// The financed vehicle behind a Loan. One loan, one vehicle -- see the doc comment on
/// Loan.vehicle for why this is not ManagedVehicle.
model LoanVehicle {
  id            String   @id @default(cuid())
  loanId        String   @unique
  chassisNumber String   @unique
  make          String?
  model         String?
  year          Int?
  color         String?
  plate         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@map("loan_vehicles")
}

/// One tenor change applied to a loan -- e.g. 36 months stretched to 60 because the
/// borrower's covenant data showed they needed a lower monthly payment, or shortened back
/// once their savings improved. A row per change, never an in-place edit of Loan's terms
/// without a trace of what they were before -- the same reasoning LenderDecision already
/// documents for credit decisions.
model LoanTenorChange {
  id              String   @id @default(cuid())
  loanId          String
  fromTenorMonths Int
  toTenorMonths   Int
  fromMonthlyRwf  Int
  toMonthlyRwf    Int
  fromDailyRwf    Int
  toDailyRwf      Int
  reason          String?
  changedByUserId String

  createdAt DateTime @default(now())

  loan      Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  changedBy User @relation("LoanTenorChangedBy", fields: [changedByUserId], references: [id])

  @@index([loanId])
  @@map("loan_tenor_changes")
}

enum LoanChangeType {
  TENOR
  CONTRIBUTION
  VEHICLE_PRICE
}

enum LoanChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
}

/// A proposed change to a loan that must be reviewed by someone other than whoever
/// proposed it before it takes effect -- the "requests permission" gate the lender
/// (Unguka/Paulin) side needed and did not have: today a lender has no write access to a
/// loan's own terms at all (only to their own decisions/info-requests/credit-notes on it).
/// This gives them a narrow, auditable way to propose a change; UZA staff review and, on
/// approval, the change is actually applied (LoanChangeRequestService.apply) and
/// everyone with a stake in the loan is notified -- see NotificationType.TASK_ASSIGNED
/// and LoanChangeRequestService for the notify-on-change wiring.
model LoanChangeRequest {
  id                 String                   @id @default(cuid())
  loanId             String
  requestedByUserId  String
  changeType         LoanChangeType
  /// Shape depends on changeType: { toTenorMonths } | { contributionRwf } | { vehiclePriceRwf }
  payload            Json
  note               String?
  status             LoanChangeRequestStatus  @default(PENDING)
  reviewedByUserId   String?
  reviewedAt         DateTime?
  reviewNote         String?
  appliedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loan         Loan  @relation(fields: [loanId], references: [id], onDelete: Cascade)
  requestedBy  User  @relation("LoanChangeRequestedBy", fields: [requestedByUserId], references: [id])
  reviewedBy   User? @relation("LoanChangeReviewedBy", fields: [reviewedByUserId], references: [id])

  @@index([loanId, status])
  @@map("loan_change_requests")
}

enum LenderDecisionOutcome {
  APPROVED
  REJECTED
  CONDITIONAL
}

/// One credit decision a bank recorded on one of its own loans.
///
/// Previously this was one enum field (`Loan.status` flipping straight to APPROVED or
/// DECLINED) with no trail of why, no room for a conditional approval's conditions, and
/// no history if a decision was later revisited. A row per decision, never an update —
/// `Loan.status` still carries the current summary for everything that reads it today,
/// but the reasoning behind it is no longer thrown away.
model LenderDecision {
  id         String                @id @default(cuid())
  loanId     String
  outcome    LenderDecisionOutcome
  reasons    String
  /// Set for CONDITIONAL only — enforced in LenderService, not the schema, matching how
  /// this codebase already prefers a service-level check over a CHECK constraint for a
  /// business rule (e.g. resolveAnnualRateBps refusing an uncovered tenor in code, not SQL).
  conditions String?

  /// The lender-side user who recorded this — a loose reference, same convention as
  /// `BankFileEvent.actorId` and `LenderConsent.capturedByRef` elsewhere in this schema,
  /// not a hard FK, since the acting user's own row may later be deactivated.
  decidedByRef String?
  decidedAt    DateTime @default(now())
  createdAt    DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId, decidedAt])
  @@map("lender_decisions")
}

/// A real question-and-answer thread between a bank and UZA staff about one loan.
///
/// Two-sided by design: `askedByRef` is always a bank user (see LenderController's own
/// guard), `answeredByRef` is always UZA staff (see AdminLoansController). Unlike
/// CreditNote below, both sides may read this — an information request is exactly the
/// part of the relationship that is meant to be visible to both.
model InfoRequest {
  id       String  @id @default(cuid())
  loanId   String
  question String
  answer   String?

  askedByRef    String?
  answeredByRef String?
  askedAt       DateTime  @default(now())
  answeredAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId, askedAt])
  @@map("info_requests")
}

/// Bank-internal underwriting notes. UZA staff must NEVER be able to read these.
///
/// Deliberately NOT modelled with any field UZA's own staff-facing queries could
/// accidentally select — the confidentiality here is structural, not a filter: no
/// `FinancingService`/`AdminLoansController` method ever touches `prisma.creditNote` at
/// all, so there is no staff-reachable code path to redact in the first place. The only
/// code that ever reads or writes this table lives behind `LenderAccessGuard` in
/// `LenderService` — the exact mechanism that already keeps one lender from seeing
/// another lender's borrowers (see `lender-access.ts`'s "THE FOUR RULES"). SUPER_ADMIN
/// can still reach it, same as every other route behind that guard, for the same reason
/// documented there ("somebody has to be able to see that a portal is broken").
model CreditNote {
  id     String @id @default(cuid())
  loanId String
  note   String

  /// The bank user who wrote it — loose reference, same convention as `decidedByRef`.
  authorRef String?
  createdAt DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId, createdAt])
  @@map("credit_notes")
}

/// The cash-collateral facility ledger. Entries, never a mutable running total -- the same
/// reasoning as every other ledger in this schema: a balance is a sum of what happened,
/// not a number somebody can edit. Currently entitles Unguka only (fn's LENDERS config is
/// the enforcement surface on read; a bank with no entries here simply sees zeroes).
/// A borrower's consent for ONE lender to see their file.
///
/// Consent under Law N° 058/2021 is specific, affirmative and revocable. Agreeing that
/// Unguka may see a file is NOT agreeing that NCBA may, so this is keyed on the pair and
/// there is deliberately no "consent to all lenders" shortcut.
///
/// Withdrawal sets `withdrawnAt` rather than deleting the row. A complaint or an audit
/// asks exactly two questions — did consent exist, and when did it end — and a deleted
/// row cannot answer either. The row is the evidence that UZA behaved correctly.
///
/// `source` records HOW consent was captured, because "the driver agreed" is not a
/// defence on its own. In-person on a signed form, in the app, or by a staff member
/// recording a conversation are three different evidentiary positions.
model LenderConsent {
  id String @id @default(cuid())

  /// The borrower, by UZA ID — the same identifier the lender sees. Not the internal
  /// user id, so a consent record survives a user row being merged or re-keyed.
  ///
  /// NULL until the applicant becomes a participant. An applicant signing at intake does
  /// not have a UZA ID yet, and consent must still be recorded at the moment it is given:
  /// it is evidence of something that happened in front of a witness, and it cannot be
  /// conditional on an identifier that is issued later. `fundApplicationId` anchors those
  /// rows until a UZA ID exists to reconcile them onto.
  uzaId String?

  /// The application the consent was signed on, where there is one.
  fundApplicationId String?
  fundApplication   FundApplication? @relation(fields: [fundApplicationId], references: [id], onDelete: SetNull)

  /// Normalised lender key, e.g. "unguka", "ncba". Matches Bank.lenderKey.
  lenderKey String

  grantedAt   DateTime  @default(now())
  withdrawnAt DateTime?

  /// How it was captured, and by whom if a staff member recorded it.
  source        ConsentSource @default(IN_APP)
  capturedByRef String?
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One live consent per borrower per lender, and per application per lender for the
  /// pre-UZA-ID case. Postgres treats NULLs as distinct in a unique index, so unassigned
  /// applications do not collide with each other on the first constraint.
  @@unique([uzaId, lenderKey])
  @@unique([fundApplicationId, lenderKey])
  @@index([lenderKey])
  @@index([fundApplicationId])
  @@map("lender_consents")
}

enum ConsentSource {
  IN_APP
  SIGNED_FORM
  STAFF_RECORDED
}

model CollateralEntry {
  id        String              @id @default(cuid())
  bankId    String
  kind      CollateralEntryKind
  amountRwf Int
  note      String?
  createdAt DateTime            @default(now())

  /// Set when this entry is UZA Empower's equity top-up for one specific candidate's
  /// vehicle purchase -- closing the gap between what they saved and what the bank asks
  /// for -- rather than a bank-wide facility deposit. Null entries (the original Unguka
  /// facility capital, for instance) still sum correctly at the bank level; this only adds
  /// the ability to also sum correctly at the loan level.
  loanId String?

  bank Bank  @relation(fields: [bankId], references: [id])
  loan Loan? @relation(fields: [loanId], references: [id])

  @@index([bankId])
  @@index([loanId])
  @@map("collateral_entries")
}

enum VehicleCondition {
  GOOD
  FAIR
  POOR
  URGENT_ATTENTION
}

/// One of the three things UZA Empower gives a lender in exchange for financing at better
/// terms than the vehicle alone would justify -- see docs discussion "UZA Empower closes
/// the equity gap, not the whole risk." A monthly report from a certified mechanic (see
/// Mechanic, job-card.state.ts's HV-certification gate applies the same way here) on the
/// actual condition of the specific vehicle securing a specific loan. This is the
/// collateral-ASSET risk signal; LoanSavingsEntry below is the ongoing-BEHAVIOUR signal.
model VehicleInspection {
  id               String           @id @default(cuid())
  loanId           String
  mechanicId       String
  inspectedAt      DateTime         @default(now())
  mileageKm        Int?
  batteryHealthPct Int?
  condition        VehicleCondition
  notes            String?

  /// What was found and what was done about it — the record NCBA asked for: "mistakes,
  /// correction measures and certificate". An array of
  /// `{ item, severity, correctiveAction, resolvedAt? }`. JSON rather than a child table
  /// because a finding has no life outside the inspection that raised it, and a lender
  /// reads the inspection as one document.
  findings       Json?
  /// The garage's overall verdict for this month. Null where the garage recorded findings
  /// but did not certify either way.
  passed         Boolean?
  /// The garage's own certificate reference, where one was issued.
  certificateRef String?
  /// When the next inspection falls due. Lets the lender see a missed month as a missed
  /// month rather than as silence.
  nextDueAt      DateTime?

  createdAt DateTime @default(now())

  loan     Loan     @relation(fields: [loanId], references: [id])
  mechanic Mechanic @relation(fields: [mechanicId], references: [id])

  @@index([loanId, inspectedAt])
  @@map("vehicle_inspections")
}

/// A single day's deposit toward a loan's required daily figure (Loan.dailyRwf --
/// loan-terms.ts: "a borrower is never shown a percentage... they are told what they pay
/// per day"). requiredDailyRwf is snapshotted per row rather than read live off the loan,
/// the same reasoning as the tariff-rate snapshot elsewhere in this estate: if the loan's
/// terms are ever restructured, a historical day's record must still say what was actually
/// required of it that day, not what is required now.
///
/// The upside this exists to capture: a candidate depositing consistently above
/// requiredDailyRwf is a live signal -- not just that they can service this loan, but that
/// they may support more (a bigger vehicle, better terms, less collateral next time). That
/// comparison is exactly `depositedRwf - requiredDailyRwf`, summed; deliberately not stored
/// as a running balance for the same not-a-mutable-total reason as every ledger here.
model LoanSavingsEntry {
  id               String   @id @default(cuid())
  loanId           String
  date             DateTime @db.Date
  depositedRwf     Int
  requiredDailyRwf Int
  createdAt        DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [id])

  @@unique([loanId, date])
  @@index([loanId, date])
  @@map("loan_savings_entries")
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// SECTION 1 — ROLES & PERMISSIONS (RBAC)
// ============================================================

model Role {
  id          String           @id @default(cuid())
  name        String           @unique // e.g. SUPER_ADMIN, MARKETPLACE_ADMIN, FINANCE_ADMIN, etc.
  description String?
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  action      String // e.g. listings:approve, invoices:confirm, payments:verify
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())

  @@unique([action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================
// SECTION 2 — USERS
// ============================================================

model User {
  id                String    @id @default(cuid())
  /// The permanent, public UZA identifier — UZA-P-2026-000141. One person, one number,
  /// across the marketplace, the academy, financing, charging and the garage. Never
  /// reissued, and deliberately not derived from anything that can change.
  ///
  /// Nullable for now so the migration is safe on a live table; a second, separate deploy
  /// makes it NOT NULL once the backfill is confirmed to have covered every row.
  uzaId             String?   @unique
  email             String    @unique
  googleId          String?   @unique
  phone             String?
  passwordHash      String
  firstName         String
  lastName          String
  isActive          Boolean   @default(true)
  isEmailVerified   Boolean   @default(false)
  isPhoneVerified   Boolean   @default(false)
  /// Set on accounts UZA staff create on someone else's behalf (a driver's or a bank
  /// officer's first login before they've picked their own password) -- see
  /// AdminUsersController.createAccount. Never set on self-registration.
  mustChangePassword Boolean  @default(false)
  preferredLanguage String    @default("en") // en, fr, rw
  profilePhoto      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  roles             UserRole[]
  buyerProfile      BuyerProfile?
  operatorProfile   OperatorProfile?
  sellers           Seller[]
  invoices          Invoice[]
  orders            Order[]
  financingRequests FinancingRequest[]
  fleetRequests     FleetRequest[]
  activityLogs      ActivityLog[]
  refreshTokens     RefreshToken[]
  authTokens        AuthToken[]
  savedListings     SavedListing[]
  vehicleBookings   VehicleBooking[]
  inquiries         Inquiry[]
  notifications     Notification[]
  listingsCreated   Listing[]          @relation("ListingCreatedBy")
  stationReviews    StationReview[]
  identityLinks     IdentityLink[]

  // --- Tunga Taxi programme (backend pack, applied 22 August 2026) ---
  wallet            Wallet?
  sweepMandate      SweepMandate?
  enrolments        Enrolment[]
  placements        PlacementProgramme[]
  readinessScores   ReadinessScore[]
  evidenceItems     EvidenceItem[]
  driverProfile     DriverProfile?
  certificates      Certificate[]
  driverAssignments DriverAssignment[]
  membership        Membership?

  // --- Workshop & lender-facing loan servicing (added wiring the built-but-unmounted
  // workshop/loan-terms logic to real endpoints — see docs/mobility-audit.md) ---
  mechanic       Mechanic?
  jobCards       JobCard[]    @relation("JobCardCustomer")
  rescueRequests RescueCall[] @relation("RescueRequestedBy")
  loans          Loan[]       @relation("LoanBorrower")

  // --- Loan lifecycle: tenor changes and the change-request approval gate ---
  tenorChangesMade    LoanTenorChange[]    @relation("LoanTenorChangedBy")
  loanChangeRequested LoanChangeRequest[]  @relation("LoanChangeRequestedBy")
  loanChangeReviewed  LoanChangeRequest[]  @relation("LoanChangeReviewedBy")

  @@index([uzaId])
  @@map("users")
}

model UserRole {
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  tokenHash String        @unique
  type      AuthTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

// ============================================================
// SECTION 3 — BUYER PROFILES
// ============================================================

enum BuyerType {
  INDIVIDUAL
  BUSINESS
  FLEET_OPERATOR
  TAXI_ASSOCIATION
  NGO
  GOVERNMENT
  SCHOOL
  HOTEL
  LOGISTICS_COMPANY
}

model BuyerProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  buyerType        BuyerType @default(INDIVIDUAL)
  organizationName String?
  taxId            String?
  address          String?
  city             String?
  country          String    @default("RW")
  nationalId       String?
  passportNumber   String?
  isVerified       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("buyer_profiles")
}

// ============================================================
// SECTION 4 — SELLERS
// ============================================================

enum SellerType {
  UZA_RWANDA_STOCK // UZA owns vehicle, physically in Rwanda
  UZA_CHINA_SOURCING // UZA sources from China/international
  LOCAL_SELLER // Local dealer/individual in Rwanda
  INTERNATIONAL_SELLER // Non-UZA seller outside Rwanda
}

/// Merchandising pipeline for catalog offers (not exclusive unit lock).
enum ListingInventoryStage {
  CHINA_UNPAID
  IN_TRANSIT
  AT_PORT
  KIGALI_STOCK
}

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

model Seller {
  id                String       @id @default(cuid())
  userId            String
  sellerType        SellerType
  status            SellerStatus @default(PENDING)
  businessName      String
  businessRegNumber String?
  taxId             String?
  contactPerson     String?
  phone             String?
  email             String?
  address           String?
  city              String?
  country           String
  logoUrl           String?
  description       String?
  isVerified        Boolean      @default(false)
  verifiedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings     Listing[]
  subscription SellerSubscription?
  parts        Part[]

  @@unique([userId, sellerType])
  @@map("sellers")
}

enum SubscriptionPlan {
  FREE
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

model SellerSubscription {
  id             String           @id @default(cuid())
  sellerId       String           @unique
  plan           SubscriptionPlan @default(FREE)
  commissionRate Float            @default(0.02) // 2% default
  listingLimit   Int              @default(5)
  startsAt       DateTime
  expiresAt      DateTime?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("seller_subscriptions")
}

// ============================================================
// SECTION 5 — CATEGORIES
// ============================================================

enum CategoryType {
  PASSENGER_EV
  TWO_THREE_WHEEL
  COMMERCIAL_EV
  EV_PARTS_ACCESSORIES
  EV_INFRASTRUCTURE_ENERGY
}

model Category {
  id           String       @id @default(cuid())
  name         String       @unique
  slug         String       @unique
  type         CategoryType
  description  String?
  iconUrl      String?
  displayOrder Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  subcategories Subcategory[]
  listings      Listing[]

  @@map("categories")
}

model Subcategory {
  id           String   @id @default(cuid())
  categoryId   String
  name         String
  slug         String   @unique
  description  String?
  iconUrl      String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  listings Listing[]

  @@unique([categoryId, name])
  @@map("subcategories")
}

// ============================================================
// SECTION 6 — LISTINGS
// ============================================================

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  SOLD
  RESERVED
  SUSPENDED
  REJECTED
  EXPIRED
  ARCHIVED
}

enum PowertrainType {
  BEV // Battery Electric Vehicle
  PHEV // Plug-in Hybrid
  HEV // Hybrid
  EREV // Extended Range
}

enum BodyType {
  SEDAN
  SUV
  HATCHBACK
  CROSSOVER
  COUPE
  MPV
  PICKUP_TRUCK
  WAGON
  MINIVAN
  BUS
  MINIBUS
  VAN
  CARGO_VAN
  TRUCK
  LIGHT_TRUCK
  HEAVY_DUTY_TRUCK
  UTILITY_VEHICLE
  DELIVERY_VEHICLE
  FORKLIFT
  INDUSTRIAL
  SHUTTLE
  MOTORCYCLE
  SCOOTER
  BICYCLE
  TRICYCLE
  CARGO_BIKE
}

enum ConditionLevel {
  NEW
  EXCELLENT
  VERY_GOOD
  GOOD
  FAIR
  NEEDS_REVIEW
}

enum SteeringPosition {
  LEFT_HAND_DRIVE
  RIGHT_HAND_DRIVE
}

enum DrivetrainType {
  FWD // Front Wheel Drive
  RWD // Rear Wheel Drive
  AWD // All Wheel Drive
  FOUR_WD
}

enum VerificationLevel {
  BASIC_LISTED
  UZA_REVIEWED
  UZA_VERIFIED
  UZA_INSPECTED
  BATTERY_VERIFIED
  PREMIUM_VERIFIED
}

enum RegistrationStatus {
  REGISTERED
  READY_FOR_REGISTRATION
  IMPORT_PENDING
  NOT_APPLICABLE
}

model Listing {
  id                   String                @id @default(cuid())
  sellerId             String
  createdByUserId      String?
  categoryId           String
  subcategoryId        String?
  listingTitle         String
  slug                 String                @unique
  status               ListingStatus         @default(DRAFT)
  sellerType           SellerType
  inventoryStage       ListingInventoryStage @default(KIGALI_STOCK)
  inventoryPaidAt      DateTime?
  portArrivedAt        DateTime?
  kigaliArrivedAt      DateTime?
  brand                String
  model                String
  trim                 String?
  manufacturingYear    Int
  isNew                Boolean               @default(true)
  condition            ConditionLevel        @default(NEW)
  bodyType             BodyType?
  powertrainType       PowertrainType        @default(BEV)
  color                String?
  seats                Int?
  steeringPosition     SteeringPosition?
  drivetrain           DrivetrainType?
  mileageKm            Float?
  hasWarranty          Boolean               @default(false)
  warrantyDetails      String?
  hasAccidentHistory   Boolean               @default(false)
  ownershipCount       Int?
  registrationStatus   RegistrationStatus?
  vehicleLocation      String?
  city                 String?
  country              String                @default("RW")
  availabilityStatus   String                @default("AVAILABLE")
  deliveryEstimateDays Int?
  videoUrl             String?
  brochureUrl          String?
  isFullOption         Boolean               @default(false)
  description          String?
  verificationLevel    VerificationLevel     @default(BASIC_LISTED)
  isFeatured           Boolean               @default(false)
  isHotDeal            Boolean               @default(false)
  isBooked             Boolean               @default(false)
  viewCount            Int                   @default(0)
  adminNotes           String? // admin only, not public
  publishedAt          DateTime?
  expiresAt            DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?

  seller             Seller                 @relation(fields: [sellerId], references: [id])
  createdBy          User?                  @relation("ListingCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  category           Category               @relation(fields: [categoryId], references: [id])
  subcategory        Subcategory?           @relation(fields: [subcategoryId], references: [id])
  evSpecs            EvSpec?
  listingPricing     ListingPricing?
  photos             ListingPhoto[]
  invoices           Invoice[]
  orders             Order[]
  savedBy            SavedListing[]
  verificationReport VerificationReport?
  promotions         ListingPromotion[]
  sustainabilityData SustainabilityMetric[]
  useCaseTags        ListingUseCase[]
  vehicleBookings    VehicleBooking[]
  inquiries          Inquiry[]

  @@index([status, sellerType])
  @@index([inventoryStage])
  @@index([brand, model])
  @@index([country, city])
  @@map("listings")
}

model EvSpec {
  id                    String   @id @default(cuid())
  listingId             String   @unique
  batteryCapacityKwh    Float?
  batteryHealthPercent  Float?
  batteryHealthReport   Boolean  @default(false)
  rangeKm               Float?
  chargingType          String? // AC, DC, CCS, CHAdeMO, Type2, etc.
  fastChargingSupported Boolean  @default(false)
  chargingTimeHours     Float?
  motorPowerKw          Float?
  topSpeedKmh           Float?
  payloadCapacityKg     Float? // commercial vehicles
  grossVehicleWeightKg  Float? // trucks/buses
  seatingCapacity       Int? // buses/vans
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("ev_specs")
}

model ListingPhoto {
  id           String   @id @default(cuid())
  listingId    String
  url          String
  altText      String?
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listing_photos")
}

enum UseCase {
  FAMILY
  TAXI
  DELIVERY
  CORPORATE
  FLEET
  SCHOOL
  HOTEL
  LOGISTICS
  INDUSTRIAL
  GOVERNMENT
  AGRICULTURE
  WAREHOUSE
  PERSONAL_MOBILITY
  COURIER
  CAMPUS
  LAST_MILE
}

model ListingUseCase {
  listingId String
  useCase   UseCase
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([listingId, useCase])
  @@map("listing_use_cases")
}

model SavedListing {
  userId    String
  listingId String
  savedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@map("saved_listings")
}

// ============================================================
// SECTION 7 — PRICING ENGINE
// ============================================================

// Admin-configurable pricing rules per seller type and route
model PricingRule {
  id                    String     @id @default(cuid())
  sellerType            SellerType
  originCountry         String? // null = applies to all origins
  destinationCountry    String? // null = applies to all destinations
  shippingCostUsd       Float?
  localChargesUsd       Float?
  taxRatePercent        Float?
  insuranceRatePercent  Float?
  storagePerDayUsd      Float?
  clearingFeeUsd        Float?
  platformMarginPercent Float?
  commissionRate        Float?
  discountRatePercent   Float?
  deliveryDaysMin       Int?
  deliveryDaysMax       Int?
  isActive              Boolean    @default(true)
  validFrom             DateTime   @default(now())
  validUntil            DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@map("pricing_rules")
}

// Calculated price stored per listing (derived from PricingRule + listing data)
model ListingPricing {
  id                     String    @id @default(cuid())
  listingId              String    @unique
  basePriceUsd           Float?
  fobPriceUsd            Float?
  sellerDesiredPayoutUsd Float? // local sellers input
  shippingCostUsd        Float?
  localChargesUsd        Float?
  taxesEstimateUsd       Float?
  insuranceUsd           Float?
  storageUsd             Float?
  clearingFeeUsd         Float?
  landingCostUsd         Float?
  marginUsd              Float?
  commissionUsd          Float?
  ruleDiscountUsd        Float?
  discountUsd            Float?
  finalPriceUsd          Float
  currency               String    @default("USD")
  priceValidUntil        DateTime?
  priceNotes             String?
  updatedAt              DateTime  @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listing_pricing")
}

// ============================================================
// SECTION 8 — VERIFICATION
// ============================================================

model VerificationReport {
  id                  String            @id @default(cuid())
  listingId           String            @unique
  verificationLevel   VerificationLevel @default(BASIC_LISTED)
  inspectionStatus    String?
  batteryReportStatus String?
  documentStatus      String?
  inspectorName       String?
  inspectionDate      DateTime?
  reportUrl           String?
  batteryReportUrl    String?
  riskNotes           String? // admin only
  verifiedAt          DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("verification_reports")
}

// ============================================================
// SECTION 9 — INVOICES
// ============================================================

enum InvoiceType {
  PROFORMA
  DEPOSIT
  BALANCE
  FINAL
  FLEET
  PARTS
  CHARGING_EQUIPMENT
}

enum InvoiceStatus {
  DRAFT
  SENT
  AWAITING_PAYMENT
  PAYMENT_SUBMITTED
  UNDER_VERIFICATION
  PAYMENT_CONFIRMED
  PARTIALLY_PAID
  FULLY_PAID
  EXPIRED
  REJECTED
  REFUNDED
  CANCELLED
}

model Invoice {
  id               String        @id @default(cuid())
  invoiceNumber    String        @unique // e.g. UZM-INV-2026-000123
  paymentReference String        @unique // e.g. UZM-PAY-2026-000483
  userId           String
  listingId        String?
  invoiceType      InvoiceType   @default(PROFORMA)
  status           InvoiceStatus @default(DRAFT)

  // Buyer snapshot at invoice time
  buyerName    String
  buyerEmail   String?
  buyerPhone   String?
  buyerAddress String?
  buyerType    String?

  // Vehicle snapshot
  vehicleBrand      String?
  vehicleModel      String?
  vehicleTrim       String?
  vehicleYear       Int?
  vehicleCondition  String?
  vehicleLocation   String?
  sellerType        SellerType?
  verificationLevel String?

  // Price breakdown snapshot
  basePriceUsd    Float?
  fobPriceUsd     Float?
  shippingCostUsd Float?
  localChargesUsd Float?
  taxesUsd        Float?
  insuranceUsd    Float?
  clearingFeeUsd  Float?
  landingCostUsd  Float?
  marginUsd       Float?
  ruleDiscountUsd Float?
  discountUsd     Float?
  totalAmountUsd  Float
  currency        String @default("USD")

  // Payment details (USD + Rwf receiving accounts snapshotted at issue)
  beneficiaryName  String?
  bankName         String?
  accountNumber    String?
  rwfBankName      String?
  rwfAccountNumber String?
  exchangeRateUsed Float?
  paymentDeadline  DateTime?
  validUntil       DateTime?
  deliveryEstimate String?

  pdfUrl    String?
  notes     String?
  issuedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id])
  listing          Listing?          @relation(fields: [listingId], references: [id])
  payments         Payment[]
  order            Order?
  financingRequest FinancingRequest?

  @@index([status])
  @@index([userId])
  @@map("invoices")
}

// ============================================================
// SECTION 10 — PAYMENTS
// ============================================================

enum PaymentStatus {
  SUBMITTED
  UNDER_VERIFICATION
  CONFIRMED
  REJECTED
  REFUNDED
}

model Payment {
  id                String        @id @default(cuid())
  invoiceId         String
  amountPaid        Float
  currency          String        @default("USD") // USD | RWF — amountPaid is in this currency
  bankName          String?
  transferReference String?
  paymentDate       DateTime?
  senderName        String?
  notes             String?
  exchangeRateUsed  Float? // effective USD→Rwf rate when paid in RWF (or snapshotted)
  status            PaymentStatus @default(SUBMITTED)
  verifiedBy        String? // admin user id
  verifiedAt        DateTime?
  rejectionReason   String?
  bankStatementRef  String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  invoice Invoice        @relation(fields: [invoiceId], references: [id])
  proofs  PaymentProof[]

  @@map("payments")
}

model PaymentProof {
  id         String   @id @default(cuid())
  paymentId  String
  fileUrl    String
  fileType   String // PDF, JPG, PNG, WEBP
  fileName   String
  uploadedAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_proofs")
}

// ============================================================
// SECTION 10b — VEHICLE BOOKINGS (China sourcing deposit)
// ============================================================

enum VehicleBookingStatus {
  AWAITING_PAYMENT
  PAYMENT_SUBMITTED
  UNDER_VERIFICATION
  CONFIRMED
  REJECTED
  CANCELLED
  EXPIRED
}

model VehicleBooking {
  id                String               @id @default(cuid())
  bookingNumber     String               @unique
  paymentReference  String               @unique
  listingId         String
  userId            String
  bookingFeeUsd     Float
  currency          String               @default("USD") // USD | RWF when proof submitted
  status            VehicleBookingStatus @default(AWAITING_PAYMENT)
  amountPaid        Float?
  bankName          String?
  transferReference String?
  paymentDate       DateTime?
  senderName        String?
  notes             String?
  exchangeRateUsed  Float?
  rejectionReason   String?
  validUntil        DateTime?
  confirmedAt       DateTime?
  verifiedBy        String?
  verifiedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  listing Listing               @relation(fields: [listingId], references: [id])
  user    User                  @relation(fields: [userId], references: [id])
  proofs  BookingPaymentProof[]

  @@index([listingId])
  @@index([userId])
  @@index([status])
  @@map("vehicle_bookings")
}

model BookingPaymentProof {
  id         String   @id @default(cuid())
  bookingId  String
  fileUrl    String
  fileType   String
  fileName   String
  uploadedAt DateTime @default(now())

  booking VehicleBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_payment_proofs")
}

// ============================================================
// SECTION 10c — VEHICLE INQUIRIES (quote-first flow)
// ============================================================

enum InquiryStatus {
  RECEIVED
  CONTACTED
  QUOTED
  CONVERTED
  CLOSED
}

enum InquiryIntent {
  BUY
  BOOK
}

model Inquiry {
  id            String        @id @default(cuid())
  quoteNumber   String        @unique
  userId        String?
  listingId     String?
  intent        InquiryIntent @default(BOOK)
  name          String
  phone         String
  email         String
  country       String
  buyerType     BuyerType
  message       String?
  status        InquiryStatus @default(RECEIVED)
  quotePdfUrl   String?
  internalNotes String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([listingId])
  @@map("inquiries")
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// ============================================================
// SECTION 11 — ORDERS & TRACKING
// ============================================================

enum OrderStatus {
  INVOICE_ISSUED
  PAYMENT_SUBMITTED

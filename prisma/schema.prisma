  createdAt    DateTime @default(now())

  /// The stable key from uza-mobility-fn's `src/config/lenders.ts` (e.g. "unguka"),
  /// lower-cased. Onboarding a lender there is meant to be a data change, not a code
  /// change — this is the other half of that: the row a `LENDER_<KEY>` role resolves to.
  /// Null for a bank that only appears in the admin financing-routing directory and has
  /// no lender portal of its own yet.
  lenderKey String? @unique

  financingRequests    FinancingRequest[]
  loans                Loan[]
  collateralEntries    CollateralEntry[]
  documentRequirements LenderRequirement[]

  @@map("banks")
}

/// One bank's own document checklist for a bank file — the per-institution version of
/// the eleven-item list `bank-files` module otherwise hardcodes.
///
/// Onboarding a new lender with a different checklist used to mean a code change to
/// `BankFileGeneratorService`. This is data instead: a bank with rows here gets its own
/// list; a bank with none falls back to the UZA default (`DEFAULT_BANK_FILE_ITEMS`) so
/// removing a partner's configuration can never silently leave a file with zero
/// requirements. `code` follows the same UPPER_SNAKE convention as `BankFileItem.code`
/// so a bank-specific requirement and a platform-generated one can sit in the same list
/// without a translation step.
model LenderRequirement {
  id     String @id @default(cuid())
  bankId String

  /// Stable, uppercase-snake identifier — matches `BankFileItem.code`'s convention.
  /// Derived from `label` at import time and never regenerated afterwards, so editing the
  /// label later does not orphan any `BankFileItem` rows already created against it.
  code      String
  label     String
  guidance  String?
  /// Almost everything a bank asks for is mandatory; this exists for the rare exception
  /// (e.g. "autorisation de transport, if you already have one").
  required  Boolean    @default(true)
  /// Defaults to `uploaded`: a newly pasted requirement is, by definition, not one of the
  /// handful of codes `BankFileGeneratorService.produce()` knows how to generate — see
  /// that file's own comment on why a generator that invents evidence is worse than one
  /// that admits it has none.
  source    ItemSource @default(uploaded)
  sortOrder Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bank Bank @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@unique([bankId, code])
  @@index([bankId, sortOrder])
  @@map("lender_requirements")
}


# Copy to .env.prod ON THE SERVER and fill in. Never commit the filled version.

# The hostname Caddy will obtain a certificate for. Point an A record at the server FIRST —
# issuance fails if the name does not already resolve, and a failed attempt is rate-limited.
MOBILITY_DOMAIN=api.uzamobility.com

# Database. Nothing but the API ever connects to it.
#   openssl rand -base64 36
POSTGRES_USER=uza
POSTGRES_PASSWORD=
POSTGRES_DB=uza_mobility

# Signs session tokens. Changing it later signs everyone out.
#   openssl rand -base64 48
JWT_SECRET=

# Comma-separated origins allowed to call the API from a browser. Leave empty until a
# frontend exists; empty means no browser origin is permitted, which is the safe default.
CORS_ORIGINS=

# ── Uploads ──────────────────────────────────────────────────────────────────────
# Uploads live in MongoDB GridFS, not on disk and not in Postgres. Mongo runs in the
# compose stack, so MONGODB_URI is set there and not here. These two have defaults but
# are worth setting deliberately:
MONGODB_DB_NAME=uza_mobility
GRIDFS_BUCKET_NAME=uploads

# REQUIRED. The public base URL an uploaded file is served from, as a browser sees it.
# Get this wrong and every image URL the API returns is unreachable, with no warning
# anywhere — it is just broken images in someone else's app.
PUBLIC_UPLOAD_BASE_URL=https://api.uzamobility.com/uploads

# ── Where the front ends live ────────────────────────────────────────────────────
# Email links and OAuth redirects point at these.
FRONTEND_URL=
ADMIN_FRONTEND_URL=

# ── Mail is REQUIRED in production (since 20 Sept 2026) ─────────────────────────
# Admin sign-in sends a one-time code by email on every login, staff invite codes are
# emailed, and simulation passwords are invalidated so real users set theirs via
# Forgot password. With MAIL_ENABLED=false none of that reaches anyone.
MAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
MAIL_FROM=
# Google sign-in (customer portal only — it never grants a role). Create an OAuth 2.0
# Web client in Google Cloud Console; authorised redirect URI must equal
# GOOGLE_REDIRECT_URI exactly, e.g. https://api.uzamobility.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
EXCHANGE_RATE_API_KEY=

# Scheduled jobs (midnight invoices, 01:00 promotions, 05:00 covenant run) must run on ONE
# instance only. Set to false on every replica but one when running more than one API.
CRON_ENABLED=true

# Private GridFS bucket for signed forms and identity papers. Never served by /uploads/*.
GRIDFS_PRIVATE_BUCKET_NAME=private_documents

# NODE_ENV=production disables every development convenience, including the echoed
# admin sign-in code when mail is off. Always set it.
NODE_ENV=production

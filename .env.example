# uza-mobility-bn — the API (NestJS)
#
# Every variable the code reads, derived from src/ rather than from memory. The process
# validates these at boot (src/config/env.validation.ts) and refuses to start in production
# with anything marked REQUIRED missing — it names what is missing, so read the first error.
# See 04-uza-cloud/deploy-env.md in the guide repository for the cross-project rules.

# ── Runtime ────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=7000
APP_NAME=UZA Mobility

# ── Data stores (REQUIRED) ─────────────────────────────────────────────────────────────
# Postgres holds every business record. Prisma reads this; migrations run with
# `npx prisma migrate deploy` before the first boot on a new host.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/uza_mobility?schema=public

# MongoDB holds uploaded files (GridFS): listing photos, documents, signatures.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/uza_mobility
MONGODB_DB_NAME=uza_mobility
GRIDFS_BUCKET_NAME=uploads

# ── Secrets (REQUIRED) ─────────────────────────────────────────────────────────────────
# Signs access AND refresh tokens. Minimum 32 characters; placeholders are refused in production.
# Generate: openssl rand -base64 48
# Rotating it signs every user out. It is NOT the same value as either front end's AUTH_SECRET.
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
EMAIL_VERIFICATION_EXPIRES_IN=24h
PASSWORD_RESET_EXPIRES_IN=1h

# ── Public addresses (REQUIRED in production, https) ───────────────────────────────────
# Where the API sends people. If these are wrong, password-reset emails and Google sign-in
# send customers to localhost. Each must EXACTLY match that app's own NEXT_PUBLIC_APP_URL.
FRONTEND_URL=https://uzamobility.com
ADMIN_FRONTEND_URL=https://admin.uzamobility.com

# Base URL under which uploaded files are served. Every image URL the API returns is built
# from this. Normally <this API's public URL>/uploads.
PUBLIC_UPLOAD_BASE_URL=https://api.uzamobility.com/uploads

# Browser origins allowed to call this API. Comma-separated, scheme + host only, no trailing
# slash, no paths. MUST include both front ends' origins or every browser call fails with an
# opaque network error. Leaving it unset allows localhost only.
CORS_ORIGINS=https://uzamobility.com,https://admin.uzamobility.com

# ── Email ──────────────────────────────────────────────────────────────────────────────
# Off by default. When off, users cannot verify email or reset passwords. When true, all four
# SMTP_* + MAIL_FROM are required.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=UZA Mobility <no-reply@uzamobility.com>
# Footer text in every email. Optional.
MAIL_COMPANY_LEGAL_NAME=UZA Solutions Ltd
MAIL_COMPANY_LOCATION=UNIFY House, Kiyovu, Kigali
MAIL_SUPPORT_URL=https://uzamobility.com/contact
MAIL_TAGLINE=Electric Mobility, Delivered.

# ── Google sign-in (optional; all three or none) ───────────────────────────────────────
# The redirect URI must be exactly <this API's public URL>/auth/google/callback and must be
# registered verbatim in Google Cloud Console → Credentials → Authorised redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.uzamobility.com/auth/google/callback

# ── Third-party ────────────────────────────────────────────────────────────────────────
# USD→RWF rate for pricing. Free tier at exchangerate-api.com. Without it /exchange-rate
# returns 503 and USD-priced listings cannot show RWF.
EXCHANGE_RATE_API_KEY=

# ── Operations ─────────────────────────────────────────────────────────────────────────
# Swagger UI at /api/docs. Always on outside production; in production only if true.
ENABLE_SWAGGER=false

# ── Seed (first boot only; `npx prisma db seed`) ───────────────────────────────────────
# Creates the first staff accounts. Each account is skipped unless EMAIL and PASSWORD are set.
# Rotate the password after first login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
SEED_ADMIN_ROLES=SUPER_ADMIN
# Optional additional seed accounts follow the same five-variable pattern:
# SEED_FINANCE_*, SEED_FLEET_*, SEED_LOGISTICS_*, SEED_SELLER_*, SEED_BUYER_*
# Path to the referred-candidates JSON. NEVER commit the file; supply the path at seed time.
TUNGA_CANDIDATES_JSON=
